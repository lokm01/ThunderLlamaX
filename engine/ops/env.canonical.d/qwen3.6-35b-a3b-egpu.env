# TLX P8 ops/env.canonical.d/qwen3.6-35b-a3b-egpu.env — the MoE model's daemon
# env (EXPERIMENTAL until the test_moe36.py serving bridge lands; the registry
# gate refuses to arm a switch to a model whose engine_host is missing).
# Numerics/knobs follow the MM P5-P7 harness configuration.
SKV=1
SKV_CTXK=98304
MM_MODEL=~/models36/Qwen3.6-35B-A3B-UD-IQ3_S.gguf
MM_PACKED=~/models36/packed/qwen3.6-35b-a3b-iq4_xs
MM_CTXS=98304
MM_SPEC=1
MM_LK=1
# pcache ON (the serve bridge landed: pcache_moe r1moe1 nodes + restore)
PC_ENABLED=1
PC_ROOT=~/prompt_cache/qwen3.6-35b-a3b-egpu
PC_QUOTA_GB=26
# P8 B.2: THE model file this engine must load
TLX_MODEL_PATH=~/models36/Qwen3.6-35B-A3B-UD-IQ3_S.gguf
# P10: the MTP K=4 chain wired as the default miss path (prose 19.6 -> 42-47
# tok/s in-harness). Kill switch = 0. NOT a config_fp knob (drafts are
# verification-only; trunk numerics unchanged — same class as MM_SPEC).
MM_MTP=1

# ---- MM SESSION B (MoE prefill campaign): the grouped-expert + seat-loop
# PF graphs (bit-exact vs the pair-walk/trunk stock -- G2/F1b gated) and the
# PF-64 tail graph. Kill switches: set any to 0 to restore the stock seq
# byte-identically (config_fp-keyed -> a pcache namespace flip per setting).
# Cache-invalidation event: first boot after this = ONE cold MoE pcache
# rebuild (svc_fp MM_* keys added -- announced).
MM_PFG=1
MM_PFM=1
MM_PF64=1
# L9 carveout for the session-B kernels (16.4KB smem -> default 32KB cfg =
# 1 CTA/SM; AUTO picks 64KB = 3 CTAs/SM: the measured 2.0-3.6x on gxm_up).
# ---- MM SESSION C (the residual attack): MM_PFT=1 = the out/o k=4096 pair on
# the pgmq8m32 mma M-GEMM (POC 7.4-8.2x isolated). NUMERICS MOVE (Tier-2,
# the dense-M32 precedent): F ~1.5e-4 banked vs the stock path; decode
# graphs UNTOUCHED (spec==t1 holds by construction). pcache namespace flip:
# ONE cold rebuild on first boot. Kill switch = 0 (byte-identical stock).
# gxm_dnf (the dn act fold, BIT-EXACT 1.32-1.36x) rides MM_PFG -- no key.
MM_PFT=1
# L9 carveout for the session-B/C kernels (pgmq8 26KB -> 64KB = 2 CTAs/SM;
# gxm_dnf 32.8KB -> 100KB = 3 CTAs/SM; gxm 16.4KB -> 64KB = 3 CTAs/SM).
NV_SMEM_CFG_AUTO_NAMES=pfg,pfa32c,gxm,gvs32,shgu,shdn,pgmq8

# ---- MM SESSION D (long-ctx + final ports): MM_PFW=1 = the row-grouped
# wide PF attention (spkqw4: K/V tiles staged to dyn smem once per tile,
# one online chain per (row,split), spkc at NP=S; 2.01x on the attention
# pair @96k). NUMERICS MOVE (Tier-2, reassociation WITHIN splits -- split
# boundaries pinned): vs stock relerr 2.0e-7 per layer; e2e dCE -0.37%
# (within SEM), top1 248/256 combined. Decode graphs UNTOUCHED. pcache
# namespace flip: ONE cold rebuild on first boot.
MM_PFW=1
# MM_PFK=1 = the k=2048 trunk mma ports (qkv/z/q/k/v on pgmq8k2 -- POC
# 4.6x/5.2x/4.75x/4.23x/3.73x isolated). Tier-2 (fp16+mma vs the fp32
# trees, F ~2.9e-4 -- the pgmq8m32 class). Kill switch = 0.
MM_PFK=1

# ---- MM SESSION E (the finale): the gathered-row-list expert mma pair +
# the split-row scan. MM_PFU=1 = gxu_gm (routed gate+up: M = the expert's
# 512 W-rows as dense 64-row mma tiles, N = the bin's activations gathered
# via plist into 16-token tiles; relerr 4.1e-4, in-chunk -49.1ms).
# MM_PFD=1 = gxd_gm (the routed-down twin at K=512, IQ4_NL nibble-split-
# by-16 decode; relerr 3.8e-4, in-chunk -35.0ms; the 3 Q6_K layers keep
# stock). MM_PFS=1 = k2s36h_{256,64}+k2nz36 (split-row GDN scan, S
# BIT-EXACT, only the yss regroup is Tier-2; -7.6ms). All decode graphs
# UNTOUCHED. MM_PFR (shared-expert mma pair) is HELD OUT (=0/unset):
# clean in isolation on all 40 layers but the e2e CE gate fails
# unexplained -- kernels + evidence committed, top known lever. pcache
# namespace flip: ONE cold rebuild on first boot (announced).
MM_PFU=1
MM_PFD=1
MM_PFS=1
