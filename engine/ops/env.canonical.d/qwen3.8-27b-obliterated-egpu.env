# TLX P8 ops/env.canonical.d/qwen3.8-27b-egpu.env — the DENSE model's daemon
# env. The union of THIS file and ops/env.common is variable-identical to the
# pre-P8 ops/env.canonical (plus the new PC_ROOT/PC_QUOTA_GB pair from the
# per-model pcache migration) — config_fp is UNCHANGED (those two are not
# behavior knobs in svc_fp._ENV_KEYS), so the migrated pcache nodes and the
# drift alarm carry over bit-exactly.
SKV=1
SKV_K=g4nw32
SKV_S=256
SKV_CTXK=100352
GEMVV=1
KV8=1
QH=1
PVH=1
HM=1
LOOKUP_K=10
PF_PREFILL=1
PF_GEMM3=1
PF_ATTN32=1
NV_SMEM_CFG_AUTO=1
NV_SMEM_CFG_AUTO_NAMES=pfg,pfa32c
PF_N32=1
PF_PRE32=1
PF_SCAN32=1
PF_M64=1
PF_M128=1
PF_DR7=1
PF_ATTNW=1
PG_SPLIT=4
PF_SCANC=1
PF_SCANC_N2=1
PF_M64QKV=1
PF_ABW=1
PC_ENABLED=1
PF_RING4=1
PF_QKV1=1
PF_P5=1
PF_OP64=1
PF_W4A8=1
# P8 B.4: per-model pcache root + quota (migration moved ~/prompt_cache here)
PC_ROOT=~/prompt_cache/qwen3.8-27b-obliterated-egpu
PC_QUOTA_GB=15
# P8 B.2: THE model file this engine must load (engine0.py reads it at boot)
TLX_MODEL_PATH=~/tinygrad-metal/models/Qwen3.8-27B-OBLITERATED-IQ3_XXS.gguf
TLX_T1_MODE=1

# P10-dense: the full-vocab draft head (Tier-1 gated 60/60 x2 + 59/59 stock;
# prose 1.43x in-harness; quote-class unchanged). Draft-source-only knob —
# NOT a config_fp/pcache key. Kill switch: remove this line.
TLX_DHEAD_FULL=1

# TLX P11-oblit: per-model pack dirs (pf_prefill.py/mtp.py/packers read these;
# unset = the shared dense dirs — set here so this model never touches the
# base dense packs or the TTT program's draft_pack)
TLX_PACKED7=~/tinygrad-metal/models/packs/qwen3.8-27b-obliterated-egpu/packed7
TLX_PACKED5=~/tinygrad-metal/models/packs/qwen3.8-27b-obliterated-egpu/packed5
TLX_DRAFT_PACK=~/tinygrad-metal/models/packs/qwen3.8-27b-obliterated-egpu/draft_pack
