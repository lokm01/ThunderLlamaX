# TLX ops/env.canonical.EXAMPLE — sanitized template (the live rig file is
# NOT published: it carries the ops admin token and the rig's model path).
#
# GENERATE your real file (one-time, on the engine host):
#   cd engine/ops
#   cp env.canonical.example env.canonical
#   chmod 600 env.canonical
#   # set a fresh admin token and your GGUF path:
#   TLX_TOK=$(openssl rand -base64 24)
#   sed -i '' -e "s|REPLACE_WITH_openssl_rand_base64_24|$TLX_TOK|" \
#             -e "s|~/tinygrad-metal/models/Qwen3.8-27B-IQ3_XXS.gguf|/path/to/your/Qwen3.8-27B-IQ3_XXS.gguf|" \
#             env.canonical
# The daemon refuses to boot without env.canonical (W2 V-27: env must be
# single-sourced); keep it 0600 (it carries the admin token).
DEV=NV
M1A_SERVE=1
SKV=1
SKV_K=g4nw32
SKV_S=256
SKV_CTXK=100352
GEMVV=1
KV8=1
QH=1
PVH=1
HM=1
M1A_KEEPALIVE_S=10
M1A_GEN_REBUILD_EVERY=256
MTP_KERNARGS_MB=256
LOOKUP_K=10
PF_PREFILL=1
PF_GEMM3=1
PF_ATTN32=1
NV_SMEM_CFG_AUTO=1
NV_SMEM_CFG_AUTO_NAMES=pfg,pfa32c
PF_N32=1
PF_PRE32=1
PF_SCAN32=1
PF_M64=1
PF_M128=1
PF_DR7=1
PF_ATTNW=1
PG_SPLIT=4
PF_SCANC=1
PF_SCANC_N2=1
PF_M64QKV=1
PF_ABW=1
PC_ENABLED=1
PF_RING4=1
PF_QKV1=1
PF_P5=1
PF_OP64=1
PF_W4A8=1
# ---- TLX W2 (security/ops) ----
# privileged-RPC token (shutdown / snapshot_save / snapshot_load); also read by
# api_server.sh for the /health debug fields. Fail-closed if removed.
TLX_ADMIN_TOKEN=REPLACE_WITH_openssl_rand_base64_24
# model identity input for config_fp (must be the file the engine loads)
TLX_MODEL_PATH=~/tinygrad-metal/models/Qwen3.8-27B-IQ3_XXS.gguf
# ---- R6 PHASE 3 batch opt-in (DEFAULT-OFF; see R6_BATCH.md) --------------
# To serve TWO concurrent conversations (bit-exact per stream): REPLACE the
# LOOKUP_K=10 line with LOOKUP_K=7, DELETE every PF_* line except PF_DR7=1,
# and add:  PF_G3M_MB=0 PF_P5=0 R6_PF_T1=1 BATCH_B=2 BATCH_REBUILD_EVERY=232
# BATCH_PF_CHUNK=64   (the R6 VRAM law + the graph-class budget law).
# Costs: 8k FRESH prefill ~30-45ms/tok (T=1 path; repeats via pcache), solo
# deep-K is K7-class. The legacy block below stays the shipped default.
# watchdog: max silent seconds on an GPU-owning RPC before clean-exit(1)
TLX_STEP_TIMEOUT_S=120
# engine-socket caps (V-24/V-31/V-30 stopgaps)
TLX_MAX_LINE_MB=4
TLX_SEND_TIMEOUT_S=10
# W5: P18 spill-law scoping — the Tier-2 prefill families (pf*/p8*) carry
# 104-592B ptxas FRAMES by design (frame != spill; the P18 nondet datapoint was
# a decode-path 276B spill). Warn-only for these names; HARD law for decode/canon.
NV_SPILL_EXEMPT_NAMES=pf,p8
