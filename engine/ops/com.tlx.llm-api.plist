<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tlx.llm-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>~/tinygrad-metal/engine0/ops/api_server.sh</string>
  </array>
  <key>UserName</key><string>%USER%</string>
  <key>WorkingDirectory</key><string>~/tinygrad-metal/engine0</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>~/tinygrad-metal/logs/llm-api-launchd.log</string>
  <key>StandardErrorPath</key><string>~/tinygrad-metal/logs/llm-api-launchd.log</string>
</dict>
</plist>
