+          k1_prg = prg.replace(src=(prg.src[0], prg.src[1], UOp(Ops.SOURCE, arg=k1_src), UOp(Ops.BINARY, arg=k1_lib)), arg=k1_arg)
+          _SKV_PENDING[key] = (prg, k1_prg, qroles)
