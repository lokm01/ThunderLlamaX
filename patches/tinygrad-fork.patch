+      if irule is None: return prg
+      sig = _SIG_RE.search(src).group(2)
+      new_name = f"{name}_a3e"
+      # batch-3 renders may permute the (x-row, rms, s48) batch order vs the output
+      # order (BEAM variants differ) — search the 6 permutations; the differential
+      # validator arbitrates. First passing perm wins; none -> stock.
+      if iroles.get("batch", 1) == 1:
