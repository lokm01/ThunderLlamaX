+    W3[:, :, 2:4] = np.ascontiguousarray(rng.uniform(0.0, 0.01, (N, 20)).astype(np.float16)).view(np.uint8).reshape(N, 20, 2)
+    W3[:, :, 4:] = rng.integers(0, 256, (N, 20, 172), dtype=np.uint8)
+  wdata = {}
+  wdata[roles["W"][1]] = Wb.tobytes()
+  wdata[roles["nw"][1]] = rng.uniform(0.5, 1.5, 5120).astype(np.float32).tobytes()
+  sp_val = 7
+  if roles["kind"] == "q5head":
+    wdata[roles["x"][1]] = rng.uniform(-1, 1, 5120).astype(np.float32).tobytes()
+  elif roles["kind"] == "q5conv" and os.getenv("A3D_DBG_Q5") == "1":
+    wdata[roles["x"][1]] = np.ones((5120,), dtype=np.float32).tobytes()
+    wdata[roles["nw"][1]] = np.ones((5120,), dtype=np.float32).tobytes()
+    wdata[roles["s"][1]] = np.array([2.0], dtype=np.float32).tobytes()
+    wdata[roles["s1"][1]] = np.array([2.3], dtype=np.float32).tobytes()
+    wdata[roles["s2"][1]] = np.array([1.7], dtype=np.float32).tobytes()
+    wdata[roles["aux"][1]] = rng.uniform(0.5, 3.0, N).astype(np.float32).tobytes()
+  else:
+    wdata[roles["x"][1]] = rng.uniform(-1, 1, 5120).astype(np.float32).tobytes()
+    wdata[roles["s"][1]] = np.array([2.3], dtype=np.float32).tobytes()
+    wdata[roles["inn"][1]] = rng.uniform(-1, 1, 3 * N).astype(np.float32).tobytes()
+  bufs, allocs, yidx = [], [], None
+  oname = roles["out"][1]
+  for ctype, name, numel in sig_args:
+    if ctype == "const int": continue
+    nbytes = numel * (2 if ctype == "half*" else 4 if ctype.endswith("*") else 4)
+    b = dev.allocator.alloc(nbytes, BufferSpec())
+    if name == oname: yidx = len(bufs); data = memoryview(bytearray(nbytes)).cast("B")
+    elif name in wdata: data = memoryview(wdata[name]).cast("B")
+    else: data = memoryview(rng.uniform(-1, 1, max(numel, 1)).astype(np.float32).tobytes()).cast("B")
+    dev.allocator._copyin(b, data)
+    bufs.append(b); allocs.append((b, nbytes))
+  rt_orig, rt_new = dev.runtime(orig_prg.to_elf()), dev.runtime(new_prg.to_elf())
+  og, ol = orig_prg.arg.launch_dims({})
+  if ol is None: ol = (1, 1, 1)
+  vals = (sp_val,) if roles["kind"] == "q5conv" else ()
+  rt_orig(*bufs, global_size=tuple(og), local_size=tuple(ol), vals=vals, wait=True)
+  mv = memoryview(bytearray(4 * roles["out"][2])); dev.allocator._copyout(mv, bufs[yidx])
+  y_orig = np.frombuffer(mv, dtype=np.float32).copy()
+  _fill = bytearray(4 * roles["out"][2])   # A3d: poison out before the new kernel so missed writes are caught
+  _fill[0::4097] = b"\xcd" * len(_fill[0::4097])
+  dev.allocator._copyin(bufs[yidx], memoryview(_fill).cast("B"))
+  rt_new(*bufs, global_size=new_dims[0], local_size=new_dims[1], vals=vals, wait=True)
+  mv2 = memoryview(bytearray(4 * roles["out"][2])); dev.allocator._copyout(mv2, bufs[yidx])
+  y_new = np.frombuffer(mv2, dtype=np.float32).copy()
+  for b, nb in allocs:
+    try: dev.allocator.free(b, nb, BufferSpec())
+    except Exception: pass
+  if not (np.isfinite(y_orig).all() and np.isfinite(y_new).all()):
+    bo = np.where(~np.isfinite(y_orig))[0]
+    bn = np.where(~np.isfinite(y_new))[0]
+    print(f"[a3d] nan/inf orig_bad={len(bo)}@{bo[:6]} new_bad={len(bn)}@{bn[:6]} "
+          f"o_vals={y_orig[bo[:4]] if len(bo) else []} n_vals={y_new[bn[:4]] if len(bn) else []}", flush=True)
+    if roles["kind"] == "q5conv":
+      # numpy ground truth for the first bad row (or row 0)
+      r0 = (bo[0] - 3 * N) if len(bo) else 0
+      Wf = np.frombuffer(wdata[roles["W"][1]], dtype=np.uint8).reshape(N, 3520)
+      xf = np.frombuffer(wdata[roles["x"][1]], dtype=np.float32)
+      nwf = np.frombuffer(wdata[roles["nw"][1]], dtype=np.float32)
+      sf = np.frombuffer(wdata[roles["s"][1]], dtype=np.float32)[0]
+      blk = Wf[r0].reshape(20, 176)
+      d = blk[:, 0:2].copy().view(np.float16).astype(np.float32).reshape(20)
+      dm = blk[:, 2:4].copy().view(np.float16).astype(np.float32).reshape(20)
+      s = blk[:, 4:16].astype(np.int32)
+      sc = np.stack([s[:, 0] & 63, s[:, 1] & 63, s[:, 2] & 63, s[:, 3] & 63,
+                     (s[:, 8] & 0xF) | ((s[:, 0] >> 6) << 4), (s[:, 9] & 0xF) | ((s[:, 1] >> 6) << 4),
+                     (s[:, 10] & 0xF) | ((s[:, 2] >> 6) << 4), (s[:, 11] & 0xF) | ((s[:, 3] >> 6) << 4)], axis=1)
+      mn = np.stack([s[:, 4] & 63, s[:, 5] & 63, s[:, 6] & 63, s[:, 7] & 63,
+                     (s[:, 8] >> 4) | ((s[:, 4] >> 6) << 4), (s[:, 9] >> 4) | ((s[:, 5] >> 6) << 4),
+                     (s[:, 10] >> 4) | ((s[:, 6] >> 6) << 4), (s[:, 11] >> 4) | ((s[:, 7] >> 6) << 4)], axis=1)
+      qh = blk[:, 16:48].astype(np.int32)
+      qs = blk[:, 48:176].astype(np.int32)
+      j = np.arange(256)
+      qv = ((qs[:, j >> 1] >> (4 * (j & 1))) & 0xF) + (((qh[:, j >> 3] >> (j & 7)) & 1) << 4)
+      w = d[:, None] * sc[:, j >> 5] * qv - dm[:, None] * mn[:, j >> 5]
+      ref = np.float32(np.float16(xf / sf * nwf)[None, :] if False else 0)  # skip half-ref; fp32 ref:
+      reff = float((xf * (1.0 / sf) * nwf * w.reshape(-1)).sum())
+      print(f"[a3d] numpy ref row {r0}: {reff:.6g} (d max {d.max()}, sc max {sc.max()}, qv max {qv.max()})", flush=True)
+    return False, float("nan")
+  off = 3 * N if roles["kind"] == "q5conv" else 0
+  yo, yn = y_orig[off:off+N], y_new[off:off+N]
+  denom = max(float(np.abs(yo).max()), 1e-9)
+  rel = float(np.abs(yo - yn).max()) / denom
+  if rel > 3e-3 and roles["kind"] == "q5conv" and os.getenv("A3D_DBG_Q5") == "ref":
+    Wf = np.frombuffer(wdata[roles["W"][1]], dtype=np.uint8).reshape(N, 3520)
+    xf = np.frombuffer(wdata[roles["x"][1]], dtype=np.float32)
+    nwf = np.frombuffer(wdata[roles["nw"][1]], dtype=np.float32)
+    sf = np.frombuffer(wdata[roles["s"][1]], dtype=np.float32)[0]
+    j = np.arange(256)
+    ref = np.zeros(N, dtype=np.float64)
+    for r in range(4):
+      blk = Wf[r].reshape(20, 176).astype(np.int32)
+      d = Wf[r].reshape(20, 176)[:, 0:2].copy().view(np.float16).astype(np.float32).reshape(20)
+      dm = Wf[r].reshape(20, 176)[:, 2:4].copy().view(np.float16).astype(np.float32).reshape(20)
+      s = blk[:, 4:16]
+      sc = np.stack([s[:, 0] & 63, s[:, 1] & 63, s[:, 2] & 63, s[:, 3] & 63,
+                     (s[:, 8] & 0xF) | ((s[:, 0] >> 6) << 4), (s[:, 9] & 0xF) | ((s[:, 1] >> 6) << 4),
+                     (s[:, 10] & 0xF) | ((s[:, 2] >> 6) << 4), (s[:, 11] & 0xF) | ((s[:, 3] >> 6) << 4)], axis=1)
+      mn = np.stack([s[:, 4] & 63, s[:, 5] & 63, s[:, 6] & 63, s[:, 7] & 63,
+                     (s[:, 8] >> 4) | ((s[:, 4] >> 6) << 4), (s[:, 9] >> 4) | ((s[:, 5] >> 6) << 4),
+                     (s[:, 10] >> 4) | ((s[:, 6] >> 6) << 4), (s[:, 11] >> 4) | ((s[:, 7] >> 6) << 4)], axis=1)
+      qh = blk[:, 16:48]; qs = blk[:, 48:176]
+      qv = ((qs[:, j >> 1] >> (4 * (j & 1))) & 0xF) + (((qh[:, j >> 3] >> (j & 7)) & 1) << 4)
+      w = d[:, None] * sc[:, j >> 5] * qv - dm[:, None] * mn[:, j >> 5]
+      ref[r] = (xf * (1.0 / sf) * nwf * w.reshape(-1)).sum()
+    print(f"[a3d] REF orig[:4]={yo[:4]} new[:4]={yn[:4]} numpy={ref[:4]}", flush=True)
+  if roles["kind"] == "q5conv":
+    c = np.abs(y_orig[:3*N] - y_new[:3*N]).max()   # passthrough part must match too
+    if c > 0: print(f"[a3d] passthrough mismatch {c}", flush=True); return False, float("nan")
+  return (rel < 3e-3 and bool(np.allclose(yo, yn, rtol=3e-3, atol=3e-3 * denom))), rel
+
