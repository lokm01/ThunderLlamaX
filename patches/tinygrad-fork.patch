+  hs = [a for a in args if a[0] == "half*"]
+  fl = [a for a in args if a[0] == "float*"]
+  if len(sc) != 1 or len(hs) != 1 or len(fl) != 2: return None
+  P, Q = (fl if fl[0][2] >= fl[1][2] else (fl[1], fl[0]))
+  KV = hs[0]
