+# ==================== SKV: split-KV attention K1/K2 (MTP_SKV) ====================
+# Replaces the T=3 probe attention pair: K1 = QK+online-softmax partials (QK kernel),
+# K2 = combine (PV kernel). Workspace partials live in a dedicated buffer whose VA
+# is baked into both kernels (allocated once per (L,T), never freed, capture-safe).
+_SKV = bool(os.getenv("MTP_SKV"))
+_SKV_S = int(os.getenv("MTP_SKV_S", "20"))
+_SKV_WS = {}       # (L, T) -> (buffer, va_int)
+_SKV_PENDING = {}  # (L, T) -> (orig_qk_prg, new_k1_prg, roles)
+_SKV_DEAD = set()  # (L, T) keys that failed -> everything stock
+_SKV_LIVE = set()  # (L, T) keys where K2 took over the PV -> softmax bookkeeping kernels are dead code
+
+def _match_skv_noop(args, src, key):
+  # dead softmax kernels once K2 owns the PV: their outputs (mx/sm/partials) fed only the stock PV
+  L = key[0]
+  if len(args) == 2 and all(a[0] == "float*" for a in args):
+    a, b = args
+    if (a[2], b[2]) in ((18432, 72 * L), (72, 18432)):   # rowmax stage1 / stage2+sumreduce
+      return True
+  if len(args) == 3 and all(a[0] == "float*" for a in args) and "exp2" in src:
+    out, P, mx = args
+    if (out[2], P[2], mx[2]) == (18432, 72 * L, 72):     # partsum
+      return True
+  return False
+
+def _skv_retro_noop(renderer, key):
+  # layers 1..15's rowmax/partsum/reduce programs are already rendered (stock) by the time
+  # K2 replaces the PV on layer 0's render; swap every cached matching program for a no-op.
+  import sys as _sys
+  cg = _sys.modules.get("tinygrad.codegen")
+  if cg is None or not hasattr(cg, "to_program_cache"): return
+  for ck, cp in list(cg.to_program_cache.items()):
+    if cp is None: continue
+    parsed = _parse(cp)
+    if parsed is None: continue
+    _, cargs, csrc = parsed
+    if not _match_skv_noop(cargs, csrc, key): continue
+    try:
+      mm = _SIG_RE.search(csrc)
+      nn = to_function_name(mm.group(1) + "_skvn")
+      nsrc = _SKV_PRELUDE + f'extern "C" __global__ void __launch_bounds__(32) {nn}({mm.group(2)}) {{\n}}\n'
+      nlib = renderer.compiler.compile_cached(nsrc)
+      narg = dc_replace(cp.arg, name=nn, global_size=(1, 1, 1), local_size=(32, 1, 1))
+      nprg = cp.replace(src=(cp.src[0], cp.src[1], UOp(Ops.SOURCE, arg=nsrc), UOp(Ops.BINARY, arg=nlib)), arg=narg)
+      cg.to_program_cache[ck] = nprg
+      _subst_cache[cp.key] = nprg
+      print(f"[skv] retro-noop <- {mm.group(1)}", flush=True)
+    except Exception as e:
+      print(f"[skv] retro-noop FAILED for {mm.group(1)}: {e}", flush=True)
+
