+            f"(12288 in src: {'12288' in src}, +256: {'+256' in src}, gidx2: {'gidx2' in src})", flush=True)
+      try:
+        with open("/tmp/skv_pv_nearmiss.cu", "w") as f: f.write(src)
+      except Exception: pass
