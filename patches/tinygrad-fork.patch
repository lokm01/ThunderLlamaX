+"""A3b: source-level substitution of IQ3_XXS lazy-dequant GEMV kernels with hand CUDA.
+
+Enabled via env (read once at import):
+  MTP_A3_OVERRIDE=<path.json>  substitute matching kernels per JSON rules
+  MTP_A3_DUMP=<dir>            dump source of structurally-matching kernels (no substitution)
+  MTP_A3_VALIDATE=0            disable the orig-vs-new self-check (default: on)
+
+JSON format (see ~/tinygrad-metal/a3b/override.json):
+  {"rules": [{"N":17408,"K":5120,"variant":"silu","template":"...body.cu","threads":128,"wpc":4}, ...]}
+Rule key is (N, K, variant). variant is structural: "silu" (s+nw+exp2 epilogue),
+"mul" (s+nw+aux), "scale" (s+nw), "add" (aux = residual add), "plain".
+Matching is by arg sizes/types only (kernel names ignored); the replacement keeps the
+original C signature verbatim (arg order/types), so kernargs marshalling, QMD setup and
+JIT=1 HCQGraph capture are untouched. Substituted kernels are renamed <name>_a3b and get
+rule-specified launch dims. Signs are computed INLINE from the scale words (XOR-parity
+form of the even_signs table, bit-exact port of gguf.py case 18) — the signs buffer arg,
+if still present in the signature, is ignored.
+"""
+from __future__ import annotations
+import os, re, json, math
+from dataclasses import replace as dc_replace
+from tinygrad.helpers import to_function_name, ansistrip
+from tinygrad.uop.ops import UOp, Ops
+
+_OVERRIDE_PATH = os.getenv("MTP_A3_OVERRIDE", "")
+_DUMP_DIR = os.getenv("MTP_A3_DUMP", "")
+_DUMP_MATCH = os.getenv("MTP_DUMP_MATCH", "")
+_VALIDATE = os.getenv("MTP_A3_VALIDATE", "1") != "0"   # 2026-09-07: validate under T3_LAZY too
+# (batch-3 subs went in UNVALIDATED before -> wrong probe logits; _val_ok() still gates
+# on ALLOW_DEVICE_USAGE so compile workers fall back to stock via the assert+except path)
+
+# validators need device access: only legal when ALLOW_DEVICE_USAGE=1 (parent-side
+# realize.py re-substitution). The to_program path runs under @Context(ALLOW_DEVICE_USAGE=0)
+# in compile workers -> eager validation launches there WEDGE the channel (watchdog reboots,
+# observed 2026-08-29). Dynamic check: the same kernel is re-substituted parent-side later.
+from tinygrad.helpers import ALLOW_DEVICE_USAGE as _ADU
+def _val_ok() -> bool: return _VALIDATE and _ADU.value == 1   # T3: eager validation launches wedge the channel during JIT=1 capture comp
+ENABLED = bool(_OVERRIDE_PATH or _DUMP_DIR)
+
+_rules: dict[tuple, dict] = {}
+if _OVERRIDE_PATH:
+  with open(_OVERRIDE_PATH) as f:
+    for r in json.load(f)["rules"]:
+      if "kind" in r: _rules[r["kind"]] = r                      # A3c attention rules
+      else: _rules[(int(r["N"]), int(r["K"]), r["variant"])] = r  # A3b GEMV rules
+
+if _DUMP_DIR: os.makedirs(_DUMP_DIR, exist_ok=True)
+_subst_cache: dict[bytes, UOp] = {}
+_orig_by_key: dict[bytes, UOp] = {}   # substituted key -> original PROGRAM (tooling)
+_dumped: set[str] = set()
+
+_SIG_RE = re.compile(r'extern "C" __global__ void (?:__launch_bounds__\(\d+\) )?(\w+)\(([^)]*)\)')
+_ARG_RE = re.compile(r'^(unsigned char\*|float\*|half\*) (\w+?)_(\d+)$')
+_SCALAR_RE = re.compile(r'^const int (\w+?)_$')
+
+def _parse(prg) -> tuple[str, list, str] | None:
+  srcs = [s.arg for s in prg.src if s.op is Ops.SOURCE]
+  if not srcs or len(srcs) > 1: return None   # A3c: vars (start_pos) allowed; scalars kept below
+  m = _SIG_RE.search(srcs[0])
+  if m is None: return None
+  args = []
+  for a in m.group(2).split(", "):
+    am = _ARG_RE.match(a.strip())
+    if am is not None: args.append((am.group(1), am.group(2), int(am.group(3))))   # (ctype, name, numel)
+    elif (sm := _SCALAR_RE.match(a.strip())) is not None:   # A3c: keep scalars as ("const int", name, 0)
+      args.append(("const int", sm.group(1), 0))
+    else: return None
+  return m.group(1), args, srcs[0]
+
+def _match(args, src):
+  """Structurally identify an IQ3_XXS lazy-dequant GEMV kernel (y = arg0, float*)."""
+  if not args or args[0][0] not in ("float*", "half*"): return None   # 2026-09-07: half outputs (GDN in_proj)
+  args = [a for a in args if a[0] != "const int"]   # A3c: scalars kept by _parse; GEMV match ignores them
+  y = args[0]
+  fl = [a for a in args if a[0] == "float*"]
+  uc = [a for a in args if a[0] == "unsigned char*"]
+  cands = []
+  for grid in [a for a in fl if a is not y and a[2] == 1024]:
+    for W in uc:
+      if W[2] % 98: continue
+      BN = W[2] // 98
+      # signs tensor: optional (inline-signs graph has none); at most one consistent one
+      Ss = [a for a in uc if a is not W and a[2] == 32 * BN]
+      if len(Ss) > 1: continue
+      S = Ss[0] if Ss else None
+      for batch in (1, 3):   # T3: probe passes feed 3 rows through the same weights
+        N = y[2] // batch if y[2] % batch == 0 else 0
+        if N < 2 or BN % N: continue
+        B = BN // N
+        K = 256 * B
+        if K < 256: continue
+        xs = [a for a in args if a is not y and a is not grid and a[2] == batch * K and a[0] in ("float*", "half*")]
+        ss = [a for a in fl if a[2] == batch]   # A3-T3: per-row RMS scales (s_1 at T=1, s_3 at T=3)
+        nws = [a for a in uc if a[2] == 4 * K]
+        auxs = [a for a in fl if a is not y and a is not grid and a[2] == batch * N]
+        if len(xs) != 1 or len(ss) > 1 or len(nws) > 1 or len(auxs) > 1: continue
+        used = {id(a) for a in [y, xs[0], grid, W, S, *ss, *nws, *auxs] if a is not None}
+        if any(id(a) not in used for a in args): continue
+        if ss and nws and auxs: variant = "mul"
+        elif ss and nws and "exp2" in src: variant = "silu"
+        elif ss and nws: variant = "scale"
+        elif auxs: variant = "add"
+        elif not ss and not nws: variant = "plain"
+        else: continue
+        cands.append(dict(y=y, x=xs[0], s=ss[0] if ss else None, nw=nws[0] if nws else None,
+                          aux=auxs[0] if auxs else None, W=W, S=S, grid=grid, batch=batch,
+                          N=N, K=K, B=B, xhalf=(xs[0][0] == "half*"), variant=variant))
+  uniq = {tuple(sorted((k, v[1] if isinstance(v, tuple) else v) for k, v in c.items())): c for c in cands}
+  cands = list(uniq.values())
+  return cands[0] if len(cands) == 1 else None
+
+_XLOAD_FLOAT = """    const int koff = xrow + (int)(((size_t)b << 8) + ((unsigned int)lane << 3));
+    const float4 xa = *((const float4*)(a3b_x + koff));
+    const float4 xb = *((const float4*)(a3b_x + koff + 4));"""
+_XNW_FLOAT = """    const int eoff = koff - xrow;   // nw is per-input-dim (not batched)
+    const float4 na = *((const float4*)(a3b_nw + eoff));
+    const float4 nb = *((const float4*)(a3b_nw + eoff + 4));
+    const float x0 = xa.x*na.x, x1 = xa.y*na.y, x2 = xa.z*na.z, x3 = xa.w*na.w;
+    const float x4 = xb.x*nb.x, x5 = xb.y*nb.y, x6 = xb.z*nb.z, x7 = xb.w*nb.w;"""
+_XPLAIN_FLOAT = """    const float x0 = xa.x, x1 = xa.y, x2 = xa.z, x3 = xa.w;
+    const float x4 = xb.x, x5 = xb.y, x6 = xb.z, x7 = xb.w;"""
+_XLOAD_HALF = """    const int koff = xrow + (int)(((size_t)b << 8) + ((unsigned int)lane << 3));
+    const uint4 xw = *((const uint4*)((const __half*)a3b_x + koff));
+    const float2 f0 = __half22float2(*((const __half2*)&xw.x));
+    const float2 f1 = __half22float2(*((const __half2*)&xw.y));
+    const float2 f2 = __half22float2(*((const __half2*)&xw.z));
+    const float2 f3 = __half22float2(*((const __half2*)&xw.w));"""
+_XNW_HALF = """    const int eoff = koff - xrow;   // nw is per-input-dim (not batched)
+    const float4 na = *((const float4*)(a3b_nw + eoff));
+    const float4 nb = *((const float4*)(a3b_nw + eoff + 4));
+    const float x0 = f0.x*na.x, x1 = f0.y*na.y, x2 = f1.x*na.z, x3 = f1.y*na.w;
+    const float x4 = f2.x*nb.x, x5 = f2.y*nb.y, x6 = f3.x*nb.z, x7 = f3.y*nb.w;"""
+_XPLAIN_HALF = """    const float x0 = f0.x, x1 = f0.y, x2 = f1.x, x3 = f1.y;
+    const float x4 = f2.x, x5 = f2.y, x6 = f3.x, x7 = f3.y;"""
+
+_EPILOGUE = {
+  "silu":  "    float u = acc * (1.0f/a3b_s[warp/A3B_N]); a3b_y[warp] = u / (1.0f + expf(-u));",
+  "mul":   "    a3b_y[warp] = a3b_aux[warp] * acc * (1.0f/a3b_s[warp/A3B_N]);",
+  "scale": "    a3b_y[warp] = acc * (1.0f/a3b_s[warp/A3B_N]);",
+  "plain": "    a3b_y[warp] = acc;",
+  "add":   "    a3b_y[warp] = acc + a3b_aux[warp];",
+}
+
+def _build_source(fname: str, sig: str, roles: dict, rule: dict) -> str:
+  N, K, B = roles["N"], roles["K"], roles["B"]
+  batch = roles.get("batch", 1)
+  threads, wpc = int(rule.get("threads", 128)), int(rule.get("wpc", int(rule.get("threads", 128)) // 32))
+  with open(rule["template"]) as f: body = f.read()
+  body = body.replace("%%BATCH%%", str(batch))
+  if roles["xhalf"]:
+    xl = _XLOAD_HALF + "\n" + (_XNW_HALF if roles["nw"] else _XPLAIN_HALF)
+  else:
+    xl = _XLOAD_FLOAT + "\n" + (_XNW_FLOAT if roles["nw"] else _XPLAIN_FLOAT)
+  def _full(a): return f"{a[1]}_{a[2]}"   # signature names carry a numel suffix (data0_17408)
+  yhalf = roles["y"][0] == "half*"
+  prologue = [(f"  half* a3b_y = {_full(roles['y'])};" if yhalf else f"  float* a3b_y = {_full(roles['y'])};"),
+              f"  const {'__half' if roles['xhalf'] else 'float'}* a3b_x = {_full(roles['x'])};"]
+  if roles["s"]: prologue.append(f"  const float* a3b_s = {_full(roles['s'])};")
+  if roles["nw"]: prologue.append(f"  const float* a3b_nw = (const float*){_full(roles['nw'])};")
+  if roles["aux"]: prologue.append(f"  const float* a3b_aux = {_full(roles['aux'])};")
+  prologue.append(f"  const unsigned char* a3b_W = {_full(roles['W'])};")
+  prologue.append(f"  const float* a3b_g = {_full(roles['grid'])};")
+
+  _epi = _EPILOGUE[roles["variant"]]
+  if yhalf:
+    import re as _re
+    _epi = _re.sub(r"a3b_y\[warp\] = (.*);", r"a3b_y[warp] = __float2half_rn(\1);", _epi)
+  body = (body.replace("%%XLOAD%%", xl).replace("%%EPILOGUE%%", _epi)
+              .replace("%%THREADS%%", str(threads)).replace("%%WPC%%", str(wpc)))
+  return (f'#include <cuda_fp16.h>\n#define A3B_N {N}\n#define A3B_K {K}\n#define A3B_BLOCKS {B}\n#define A3B_BATCH {batch}\n'
+          f'extern "C" __global__ void {fname}({sig}) {{\n' + "\n".join(prologue) + "\n" + body + "\n}\n")
+
+def _mk_blocks(rng, nblocks):
+  """Random but VALID IQ3_XXS blocks (finite d; mirrors a3a_bench.make_blocks)."""
+  import numpy as np
+  b = np.zeros((nblocks, 98), dtype=np.uint8)
+  d = rng.lognormal(-7.8, 0.4, nblocks).astype(np.float16)
+  b[:, :2] = np.ascontiguousarray(d).view(np.uint8).reshape(nblocks, 2)
+  b[:, 2:66] = rng.integers(0, 256, (nblocks, 64), dtype=np.uint8)
+  words = rng.integers(0, 1 << 32, (nblocks, 8), dtype=np.uint64).astype(np.uint32)
+  b[:, 66:98] = np.ascontiguousarray(words).view(np.uint8).reshape(nblocks, 32)
+  return b, words
+
+def _signs_bytes(blocks: "np.ndarray", N: int, B: int) -> bytes:
+  """Consistent signs tensor ([row][block][32] row-major) for given raw blocks."""
+  import numpy as np
+  words = np.ascontiguousarray(blocks[:, 66:98]).view(np.uint32).reshape(N * B, 8)
+  shifts = np.array([0, 7, 14, 21], dtype=np.uint32)
+  idx = ((words[:, :, None] >> shifts) & 0x7F).reshape(N * B, 32).astype(np.int32)
+  esign = np.array([i | (0x80 if bin(i).count("1") % 2 else 0) for i in range(128)], dtype=np.uint8)
+  return esign[idx].reshape(N, B, 32).tobytes()
+
+def _nbytes(ctype: str, numel: int) -> int:
+  return numel * (1 if ctype == "unsigned char*" else (2 if ctype == "half*" else 4))
+
+def _validate(renderer, orig_prg, new_prg, roles, sig_args, new_dims):
+  """Run orig and substituted kernel on random buffers, compare outputs. Raises on mismatch."""
+  import numpy as np
+  from tinygrad.device import Device, BufferSpec
+  dev = Device[renderer.target.device]
+  rng = np.random.default_rng(1234)
+  N, B = roles["N"], roles["B"]
+  blocks, _ = _mk_blocks(rng, N * B)
+  W_bytes = blocks.tobytes()
+  bufs, allocs = [], []
+  wname = roles["W"][1]
+  for ctype, name, numel in sig_args:
+    nbytes = _nbytes(ctype, numel)
+    b = dev.allocator.alloc(nbytes, BufferSpec())
+    if name == wname: data = memoryview(W_bytes).cast("B")
+    elif name == roles["y"][1]: data = memoryview(bytearray(nbytes)).cast("B")
+    elif roles.get("S") and name == roles["S"][1]: data = memoryview(_signs_bytes(blocks, N, B)).cast("B")
+    elif roles["s"] and name == roles["s"][1]:
+      _sv = np.array([2.3, 0.7, 1.9][:numel], dtype=np.float32)   # batch-distinct, FULL fill
+      data = memoryview(_sv.tobytes()).cast("B")
+    elif roles["nw"] and name == roles["nw"][1]:   # norm weight: fp32 viewed as bytes
+      data = memoryview(rng.uniform(0.5, 1.5, numel // 4).astype(np.float32).tobytes()).cast("B")
+    elif ctype == "unsigned char*": data = memoryview(rng.integers(0, 256, numel, dtype=np.uint8).tobytes()).cast("B")
+    elif ctype == "half*": data = memoryview(rng.uniform(-1, 1, numel).astype(np.float16).tobytes()).cast("B")
+    else: data = memoryview(rng.uniform(-1, 1, numel).astype(np.float32).tobytes()).cast("B")
+    dev.allocator._copyin(b, data)
+    bufs.append(b); allocs.append((b, nbytes))
+  yidx = [a[1] for a in sig_args].index(roles["y"][1])
+  rt_orig, rt_new = dev.runtime(orig_prg.to_elf()), dev.runtime(new_prg.to_elf())
+  og, ol = orig_prg.arg.launch_dims({})
+  if ol is None: ol = (1, 1, 1)
+  rt_orig(*bufs, global_size=tuple(og), local_size=tuple(ol), vals=(), wait=True)
+  mv = memoryview(bytearray(4 * N)); dev.allocator._copyout(mv, bufs[yidx]); y_orig = np.frombuffer(mv, dtype=np.float32).copy()
+  rt_new(*bufs, global_size=new_dims[0], local_size=new_dims[1], vals=(), wait=True)
+  mv2 = memoryview(bytearray(4 * N)); dev.allocator._copyout(mv2, bufs[yidx]); y_new = np.frombuffer(mv2, dtype=np.float32).copy()
+  # timing (b2b): helps pick launch configs; not part of correctness
+  import time as _time
+  _REPS = 30
+  t0 = _time.perf_counter()
+  for _ in range(_REPS): rt_orig(*bufs, global_size=tuple(og), local_size=tuple(ol), vals=(), wait=True)
+  t_orig = (_time.perf_counter() - t0) / _REPS * 1e6
+  t0 = _time.perf_counter()
+  for _ in range(_REPS): rt_new(*bufs, global_size=new_dims[0], local_size=new_dims[1], vals=(), wait=True)
+  t_new = (_time.perf_counter() - t0) / _REPS * 1e6
+  print(f"[a3b]   b2b: orig={t_orig:.0f}us new={t_new:.0f}us", flush=True)
+  for b, nbytes in allocs:
+    try: dev.allocator.free(b, nbytes, BufferSpec())
+    except Exception: pass
+  if not (np.isfinite(y_orig).all() and np.isfinite(y_new).all()):
+    print(f"[a3b] validation nan/inf: orig finite={np.isfinite(y_orig).all()} new finite={np.isfinite(y_new).all()}", flush=True)
+    return False, float("nan")
+  denom = max(float(np.abs(y_orig).max()), 1e-9)
+  rel = float(np.abs(y_orig - y_new).max()) / denom
+  ok = rel < 1e-3 and bool(np.allclose(y_orig, y_new, rtol=1e-3, atol=1e-3 * denom))
+  return ok, rel
+
+
+# ---- A3c: O(L) attention kernel substitution (rowmax / rowsum / pv) ----
+_ROWMAX_BODY = """  const int r = blockIdx.x;
+  const int tid = threadIdx.x;
+  const int n = %%SP%% + 1;
+  const size_t base = (size_t)r * (size_t)%%L%%;
+  float m = __int_as_float(0xff800000u);   // -inf (0xff800000), NOT 0x7f800000 which is +inf
+  {
+    const float4* p4 = (const float4*)(%%IN%% + base);
+    const int n4 = n >> 2;
+    for (int i = tid; i < n4; i += %%NT%%) {
+      float4 v = p4[i];
+      m = fmaxf(m, fmaxf(fmaxf(v.x, v.y), fmaxf(v.z, v.w)));
+    }
+    for (int t = (n4 << 2) + tid; t < n; t += %%NT%%) m = fmaxf(m, %%IN%%[base + t]);
+  }
+  __shared__ float sh[%%NT%%];
+  sh[tid] = m;
+  __syncthreads();
+  for (int s = %%NT%% >> 1; s > 0; s >>= 1) {
+    if (tid < s) sh[tid] = fmaxf(sh[tid], sh[tid + s]);
+    __syncthreads();
+  }
+  if (tid == 0) %%OUT%%[r] = sh[0];"""
+
+_ROWSUM_BODY = """  const int r = blockIdx.x;
+  const int tid = threadIdx.x;
+  const int n = %%SP%% + 1;
+  const size_t base = (size_t)r * (size_t)%%L%%;
+  const float mr = %%M%%[r];
+  float acc = 0.0f;
+  {
+    const float4* p4 = (const float4*)(%%IN%% + base);
+    const int n4 = n >> 2;
+    for (int i = tid; i < n4; i += %%NT%%) {
+      float4 v = p4[i];
+      acc += exp2f((v.x - mr) * 1.4426950408889634f) + exp2f((v.y - mr) * 1.4426950408889634f)
+           + exp2f((v.z - mr) * 1.4426950408889634f) + exp2f((v.w - mr) * 1.4426950408889634f);
+    }
+    for (int t = (n4 << 2) + tid; t < n; t += %%NT%%) acc += exp2f((%%IN%%[base + t] - mr) * 1.4426950408889634f);
+  }
+  __shared__ float sh[%%NT%%];
+  sh[tid] = acc;
+  __syncthreads();
+  for (int s = %%NT%% >> 1; s > 0; s >>= 1) {
+    if (tid < s) sh[tid] += sh[tid + s];
+    __syncthreads();
+  }
+  if (tid == 0) %%OUT%%[r] = sh[0];"""
+
+_PV_BODY = """  const int gx = blockIdx.x;          // 8
+  const int gy = blockIdx.y;          // 12
+  const int x = threadIdx.x, y = threadIdx.y, z = threadIdx.z;
+  const int d = x + (y << 4) + (gx << 5);          // 0..255, matches original alu0
+  const int xy = x + (y << 4);
+  const int n = %%SP%% + 1;
+  const size_t L = (size_t)%%L%%;
+  const float* pr0 = %%PROBS%% + (size_t)gy * 2 * L;      // score row 2*gy
+  const float* pr1 = pr0 + L;                              // score row 2*gy+1
+  const __half* vp = (const __half*)%%V%% + (size_t)1024 * L + (size_t)(gy / 3) * (size_t)(L * 256);
+  float acc0 = 0.0f, acc1 = 0.0f;
+  {
+    const float4* q0 = (const float4*)pr0;
+    const float4* q1 = (const float4*)pr1;
+    const int n4 = n >> 2;
+    #pragma unroll 2
+    for (int i = z; i < n4; i += 32) {
+      const float4 p0 = __ldg(q0 + i);
+      const float4 p1 = __ldg(q1 + i);
+      const size_t tb = (size_t)i * 1024;   // i is the quad index (t = 4i), so v offset = 4i*256
+      acc0 += p0.x * __half2float(__ldg(vp + tb + d));         acc1 += p1.x * __half2float(__ldg(vp + tb + d));
+      acc0 += p0.y * __half2float(__ldg(vp + tb + 256 + d));   acc1 += p1.y * __half2float(__ldg(vp + tb + 256 + d));
+      acc0 += p0.z * __half2float(__ldg(vp + tb + 512 + d));   acc1 += p1.z * __half2float(__ldg(vp + tb + 512 + d));
+      acc0 += p0.w * __half2float(__ldg(vp + tb + 768 + d));   acc1 += p1.w * __half2float(__ldg(vp + tb + 768 + d));
+    }
+    for (int t = (n4 << 2) + z; t < n; t += 32) {
+      const float p0 = __ldg(pr0 + t), p1 = __ldg(pr1 + t);
+      const float vv = __half2float(__ldg(vp + (size_t)t * 256 + d));
+      acc0 += p0 * vv; acc1 += p1 * vv;
+    }
+  }
+  __shared__ float sh0[32][32], sh1[32][32];
+  sh0[z][xy] = acc0;
+  sh1[z][xy] = acc1;
+  __syncthreads();
+  if (z == 0) {
+    float a0 = 0.0f, a1 = 0.0f;
+    #pragma unroll
+    for (int k = 0; k < 32; k++) { a0 += sh0[k][xy]; a1 += sh1[k][xy]; }
+    const int alu7 = d + (gy << 10);
+    const int alu8 = d + (gy << 9);
+    %%OUT%%[alu8] = a0 * (1.0f/(1.0f + exp2f(%%GATE%%[alu7 + 256] * -1.4426950216293335f)));
+    %%OUT%%[alu8 + 256] = a1 * (1.0f/(1.0f + exp2f(%%GATE%%[alu7 + 768] * -1.4426950216293335f)));
+  }"""
+
+_ATTN_PRELUDE = """typedef unsigned int uint;
+#define INFINITY (__int_as_float(0x7f800000))
+#define NAN (__int_as_float(0x7fffffff))
+#include <cuda_fp16.h>
+"""
+
+def _attn_rules() -> dict:
+  return {r["kind"]: r for r in _rules.values() if "kind" in r}
+
+def _match_rowmax(args, src):
+  if len(args) != 3 or "(float)(-INFINITY)" not in src: return None
+  sc = [a for a in args if a[0] == "const int"]
+  fl = [a for a in args if a[0] == "float*"]
+  if len(sc) != 1 or len(fl) != 2 or args[0] is not fl[0]: return None
+  out, inn = fl if fl[0][2] <= fl[1][2] else (fl[1], fl[0])
+  if out[2] != 24 or inn[2] % 24 or inn[2] // 24 < 1024: return None
+  return dict(kind="rowmax", out=out, inn=inn, sp=sc[0], N=24, L=inn[2] // 24)
+
+def _match_rowsum(args, src):
+  if len(args) != 4 or "exp2" not in src: return None
+  sc = [a for a in args if a[0] == "const int"]
+  fl = [a for a in args if a[0] == "float*"]
+  if len(sc) != 1 or len(fl) != 3 or args[0] is not fl[0]: return None
+  rest = sorted(fl[1:], key=lambda a: a[2])
+  m, inn = rest
+  if fl[0][2] != 24 or m[2] != 24 or inn[2] % 24 or inn[2] // 24 < 1024: return None
+  return dict(kind="rowsum", out=fl[0], inn=inn, m=m, sp=sc[0], N=24, L=inn[2] // 24)
+
+def _match_pv(args, src):
+  if len(args) != 5 or "exp2" not in src: return None
+  sc = [a for a in args if a[0] == "const int"]
+  hs = [a for a in args if a[0] == "half*"]
+  fl = [a for a in args if a[0] == "float*"]
+  if len(sc) != 1 or len(hs) != 1 or len(fl) != 3 or args[0] is not fl[0]: return None
+  out = fl[0]
+  by_n = sorted(fl[1:], key=lambda a: a[2])
+  gate, probs = by_n[0], by_n[1]
+  cache = hs[0]
+  O, P, H, G = out[2], probs[2], cache[2], gate[2]
+  if O != 6144 or P % 24 or H % 2048: return None
+  L = H // 2048
+  if L < 1024 or P // L != 24 or G != 2 * O or O // 256 * L != P: return None   # heads = O/256; P = heads*L
+  return dict(kind="pv", out=out, probs=probs, cache=cache, gate=gate, sp=sc[0], L=L, O=O)
+
+def _build_attn(roles, rule, fname, sig):
+  kind = roles["kind"]
+  nt = int(rule.get("threads", 256))
+  sub = {"%%SP%%": roles["sp"][1] + "_", "%%L%%": str(roles["L"]), "%%NT%%": str(nt),
+         "%%OUT%%": roles["out"][1] + "_" + str(roles["out"][2])}
+  if kind == "rowmax":
+    body = _ROWMAX_BODY; sub["%%IN%%"] = roles["inn"][1] + "_" + str(roles["inn"][2])
+    grid, local = (roles["N"], 1, 1), (nt, 1, 1)
+  elif kind == "rowsum":
+    body = _ROWSUM_BODY
+    sub["%%IN%%"] = roles["inn"][1] + "_" + str(roles["inn"][2])
+    sub["%%M%%"] = roles["m"][1] + "_" + str(roles["m"][2])
+    grid, local = (roles["N"], 1, 1), (nt, 1, 1)
+  else:
+    body = _PV_BODY
+    sub["%%PROBS%%"] = roles["probs"][1] + "_" + str(roles["probs"][2])
+    sub["%%V%%"] = roles["cache"][1] + "_" + str(roles["cache"][2])
+    sub["%%GATE%%"] = roles["gate"][1] + "_" + str(roles["gate"][2])
+    grid, local = (8, 12, 1), (16, 2, 32)
+  src = _ATTN_PRELUDE + f'extern "C" __global__ void __launch_bounds__({local[0]*local[1]*local[2]}) {fname}({sig}) {{\n' + body + "\n}\n"
+  for k, v in sub.items(): src = src.replace(k, v)
+  return src, grid, local
+
+def _validate_attn(renderer, orig_prg, new_prg, roles, sig_args, new_dims):
+  import numpy as np
+  from tinygrad.device import Device, BufferSpec
+  dev = Device[renderer.target.device]
+  rng = np.random.default_rng(4242)
+  L = roles["L"]
+  sp_val = L - 1
+  wdata = {}
+  big = roles.get("inn", roles.get("probs"))
+  wdata[big[1]] = rng.uniform(-1, 1, (big[2],)).astype(np.float32)
+  if roles["kind"] == "rowsum": wdata[roles["m"][1]] = rng.uniform(0.5, 2.0, (roles["N"],)).astype(np.float32)
+  if roles["kind"] == "pv":
+    import os as _os
+    if _os.getenv("A3C_DBG_PV"):
+      # deterministic probes: v==1, gate==0 -> out = 0.5 * rowsum(probs); row identity visible
+      pr = np.zeros((roles["probs"][2],), dtype=np.float32)
+      for h in range(24):
+        for t in range(roles["L"]):
+          pr[h * roles["L"] + t] = (h % 2) * 1000.0 + (t / 100.0)   # head parity flag + t/100
+      wdata[roles["probs"][1]] = pr
+      wdata[roles["cache"][1]] = np.ones((roles["cache"][2],), dtype=np.float16)
+      g = np.zeros((roles["gate"][2],), dtype=np.float32)
+      if _os.getenv("A3C_DBG_PV") == "gate":
+        # deterministic per-element gate: value reveals index identity
+        g = (np.arange(roles["gate"][2], dtype=np.float32) % 97) * 0.01
+      wdata[roles["gate"][1]] = g
+    else:
+      wdata[roles["probs"][1]] = rng.uniform(0, 1, (roles["probs"][2],)).astype(np.float32)
+      wdata[roles["cache"][1]] = rng.uniform(-1, 1, (roles["cache"][2],)).astype(np.float16)
+      wdata[roles["gate"][1]] = rng.uniform(-2, 2, (roles["gate"][2],)).astype(np.float32)
+  bufs, allocs, yidx = [], [], None
+  oname = roles["out"][1]
+  for ctype, name, numel in sig_args:
+    if ctype == "const int": continue
+    nbytes = numel * (2 if ctype == "half*" else 4)
+    b = dev.allocator.alloc(nbytes, BufferSpec())
+    if name == oname:
+      yidx = len(bufs); data = memoryview(bytearray(nbytes)).cast("B")
+    elif name in wdata: data = memoryview(wdata[name].tobytes()).cast("B")
+    else: data = memoryview(rng.uniform(-1, 1, numel).astype(np.float32).tobytes()).cast("B")
+    dev.allocator._copyin(b, data)
+    bufs.append(b); allocs.append((b, nbytes))
+  rt_orig, rt_new = dev.runtime(orig_prg.to_elf()), dev.runtime(new_prg.to_elf())
+  og, ol = orig_prg.arg.launch_dims({})
+  if ol is None: ol = (1, 1, 1)
+  vals = (sp_val,)
+  rt_orig(*bufs, global_size=tuple(og), local_size=tuple(ol), vals=vals, wait=True)
+  mv = memoryview(bytearray(4 * roles["out"][2])); dev.allocator._copyout(mv, bufs[yidx])
+  y_orig = np.frombuffer(mv, dtype=np.float32).copy()
+  _fill = bytearray(4 * roles["out"][2])   # A3d: poison out before the new kernel so missed writes are caught
+  _fill[0::4097] = b"\xcd" * len(_fill[0::4097])
+  dev.allocator._copyin(bufs[yidx], memoryview(_fill).cast("B"))
+  rt_new(*bufs, global_size=new_dims[0], local_size=new_dims[1], vals=vals, wait=True)
+  mv2 = memoryview(bytearray(4 * roles["out"][2])); dev.allocator._copyout(mv2, bufs[yidx])
+  y_new = np.frombuffer(mv2, dtype=np.float32).copy()
+  for b, nb in allocs:
+    try: dev.allocator.free(b, nb, BufferSpec())
+    except Exception: pass
+  if not (np.isfinite(y_orig).all() and np.isfinite(y_new).all()):
+    print(f"[a3c] validation nan/inf orig_finite={np.isfinite(y_orig).all()} new_finite={np.isfinite(y_new).all()} "
+          f"orig[:6]={y_orig[:6]} new[:6]={y_new[:6]}", flush=True); return False, float("nan")
+  denom = max(float(np.abs(y_orig).max()), 1e-9)
+  rel = float(np.abs(y_orig - y_new).max()) / denom
+  if rel >= 1e-4 and np.isfinite(y_new).all():
+    idx = list(range(0, min(12, len(y_orig))))
+    print(f"[a3c] MISMATCH DETAIL orig[{idx}]={y_orig[:12]}", flush=True)
+    print(f"[a3c] MISMATCH DETAIL new [{idx}]={y_new[:12]}", flush=True)
+    print(f"[a3c] ratio new/orig = {y_new[:12] / np.where(np.abs(y_orig[:12])>1e-9, y_orig[:12], 1.0)}", flush=True)
+  return (rel < 1e-4 and bool(np.allclose(y_orig, y_new, rtol=1e-4, atol=1e-4 * denom))), rel
+
+
