+# ---- A3e: GDN in_proj IQ3 GEMV (r_48_2): warp-per-row, half products, swish epilogue ----
+_IQ3SW_BODY = """  const int warp = (blockIdx.x * %%WPC%%) + (threadIdx.x >> 5);
+  if (warp >= %%NROWS%%) return;
+  const int lane = threadIdx.x & 31;
+  const int bidx = warp / %%N%%;          // batch row (T3: 0..2; T1: 0)
+  const int rb = (bidx == 0 ? %%R0%% : (bidx == 1 ? %%R1%% : %%R2%%));   // rms batch perm (agent-derived (2,0,1))
+  const int xrow = bidx * 5120;   // x rows are IDENTITY-ordered vs output batches
+  const float inv_s = 1.0f / %%RMS%%[rb];
+  const unsigned char* rowp = %%W%% + (size_t)(warp - bidx * %%N%%) * 1960u;
+  float acc = 0.0f;
+  #pragma unroll 4
+  for (int b = 0; b < 20; ++b) {
+    const unsigned char* blk = rowp + (size_t)b * 98u;
+    const float d = __half2float(*((const __half*)blk));
+    const unsigned short* scw = (const unsigned short*)(blk + 66);
+    const unsigned int sw = ((unsigned int)scw[2*(lane>>2)]) | (((unsigned int)scw[2*(lane>>2)+1]) << 16);
+    const float db = d * (((float)(sw >> 28)) + 0.5f) * 0.5f;
+    const unsigned int sidx = (sw >> (7u * (unsigned int)(lane & 3))) & 0x7Fu;
+    const unsigned int spar = (sidx ^ (sidx>>1) ^ (sidx>>2) ^ (sidx>>3) ^ (sidx>>4) ^ (sidx>>5) ^ (sidx>>6)) & 1u;
+    const unsigned int q = ((unsigned int)blk[2 + 2*lane]) | (((unsigned int)blk[3 + 2*lane]) << 8);
+    const float4 g0 = *((const float4*)(%%GRID%% + ((q & 0xFFu) << 2)));
+    const float4 g1 = *((const float4*)(%%GRID%% + ((q >> 8) << 2)));
+    const int koff = (b << 8) + (lane << 3);
+    const float4 xa = *((const float4*)(%%X%% + xrow + koff));
+    const float4 xb = *((const float4*)(%%X%% + xrow + koff + 4));
+    const float4 na = *((const float4*)((const float*)%%NW%% + koff));
+    const float4 nb = *((const float4*)((const float*)%%NW%% + koff + 4));
+    const float sg0 = ((sidx>>0)&1) ? -1.0f : 1.0f;
+    const float sg1 = ((sidx>>1)&1) ? -1.0f : 1.0f;
+    const float sg2 = ((sidx>>2)&1) ? -1.0f : 1.0f;
+    const float sg3 = ((sidx>>3)&1) ? -1.0f : 1.0f;
+    const float sg4 = ((sidx>>4)&1) ? -1.0f : 1.0f;
+    const float sg5 = ((sidx>>5)&1) ? -1.0f : 1.0f;
+    const float sg6 = ((sidx>>6)&1) ? -1.0f : 1.0f;
+    const float sg7 = spar ? -1.0f : 1.0f;
+    const float wv0 = db * g0.x * sg0, wv1 = db * g0.y * sg1, wv2 = db * g0.z * sg2, wv3 = db * g0.w * sg3;
+    const float wv4 = db * g1.x * sg4, wv5 = db * g1.y * sg5, wv6 = db * g1.z * sg6, wv7 = db * g1.w * sg7;
+    acc += __half2float(__hmul(__float2half(xa.x*inv_s*na.x), __float2half(wv0)))
+         + __half2float(__hmul(__float2half(xa.y*inv_s*na.y), __float2half(wv1)));
+    acc += __half2float(__hmul(__float2half(xa.z*inv_s*na.z), __float2half(wv2)))
+         + __half2float(__hmul(__float2half(xa.w*inv_s*na.w), __float2half(wv3)));
+    acc += __half2float(__hmul(__float2half(xb.x*inv_s*nb.x), __float2half(wv4)))
+         + __half2float(__hmul(__float2half(xb.y*inv_s*nb.y), __float2half(wv5)));
+    acc += __half2float(__hmul(__float2half(xb.z*inv_s*nb.z), __float2half(wv6)))
+         + __half2float(__hmul(__float2half(xb.w*inv_s*nb.w), __float2half(wv7)));
+  }
+  #pragma unroll
+  for (int o = 16; o > 0; o >>= 1) acc += __shfl_down_sync(0xffffffffu, acc, o);
+  if (lane == 0) {
+    const float v = %%VEC%%[warp];
+    const int sb = (bidx == 0 ? %%S0%% : (bidx == 1 ? %%S1%% : %%S2%%));   // s48 batch perm
+    const float sp = 1.0f / %%S48%%[(sb * (%%N%% >> 7)) + ((warp - bidx * %%N%%) >> 7)];
+    const float m = *((const float*)%%NWO%% + (warp & 127));
+    const __half h5 = __float2half(acc);
+    const __half swv = __hmul(h5, hrcp((__half)1.0f + hexp2(__hmul(h5, __float2half(-1.4423828125f)))));
+    %%OUT%%[warp] = (__half)((v * sp * m) * ((float)swv));
+  }"""
+
+def _match_iq3swish(args, src):
+  if len(args) != 9: return None
+  hs = [a for a in args if a[0] == "half*"]
+  fl = [a for a in args if a[0] == "float*"]
+  uc = [a for a in args if a[0] == "unsigned char*"]
+  if len(hs) != 1 or len(uc) != 3 or len(fl) != 5: return None
+  out = args[0]
+  if out[0] != "half*" or out is not hs[0]: return None
+  W = max(uc, key=lambda a: a[2])
+  if W[2] % 1960 or out[2] * 1960 != W[2]: return None
+  R = out[2]
+  if R < 1024: return None
+  rest_uc = [a for a in uc if a is not W]
+  nw = next((a for a in rest_uc if a[2] == 20480), None)
+  nwo = next((a for a in rest_uc if a is not nw), None)
+  if nw is None or nwo is None or nwo[2] * 12 != R: return None   # nwo = R/12 bytes = R/48 floats (o&127 index)
+  by = {a[2]: a for a in fl}
+  x, grid, rms = by.get(5120), by.get(1024), by.get(1)
+  vec, s48 = by.get(R), by.get(R >> 7)
+  if None in (x, grid, rms, vec, s48): return None
+  if "exp2" not in src: return None
+  return dict(kind="iq3swish", out=out, vec=vec, s48=s48, nwo=nwo, x=x, rms=rms, nw=nw, W=W, grid=grid, N=R)
+
+def _match_iq3swish_t3(args, src):
+  # 10-arg batch-3 render of the same in_proj GEMV (fused swish epilogue)
+  if len(args) != 10: return None
+  out = args[0]
+  if out[0] != "half*": return None
+  fl = [a for a in args if a[0] == "float*"]
+  uc = [a for a in args if a[0] == "unsigned char*"]
+  if len(fl) != 5 or len(uc) != 4: return None
+  R3 = out[2]
+  if R3 < 3*1024 or R3 % 3: return None
+  R = R3 // 3
+  W = max(uc, key=lambda a: a[2])
+  if W[2] != R * 1960: return None
+  rest_uc = [a for a in uc if a is not W]
+  nw = next((a for a in rest_uc if a[2] == 20480), None)
+  nwo = next((a for a in rest_uc if a is not nw and a[2] == R // 12), None)
+  if nw is None or nwo is None: return None
+  sgns = next((a for a in rest_uc if a is not nw and a is not nwo), None)
+  if sgns is None or sgns[2] != 32 * R * 20: return None   # external signs table
+  by = {a[2]: a for a in fl}
+  x, grid, rms, vec, s48 = by.get(3*5120), by.get(1024), by.get(3), by.get(R3), by.get(3*(R >> 7))
+  if None in (x, grid, rms, vec, s48): return None
+  if "exp2" not in src: return None
+  return dict(kind="iq3swish_t3", out=out, vec=vec, s48=s48, nwo=nwo, x=x, rms=rms, nw=nw, W=W, grid=grid, N=R, batch=3, sgns=sgns)
+
+def _build_iq3sw(roles, rule, fname, sig):
+  wpc = int(rule.get("wpc", 4))
+  def _n(a): return f"{a[1]}_{a[2]}"
+  _rperm = roles.get("rperm", (0, 1, 2))
+  _sperm = roles.get("sperm", (0, 1, 2))
+  sub = {"%%WPC%%": str(wpc), "%%NROWS%%": str(roles["N"] * roles.get("batch", 1)), "%%N%%": str(roles["N"]),
+         "%%R0%%": str(_rperm[0]), "%%R1%%": str(_rperm[1]), "%%R2%%": str(_rperm[2]),
+         "%%S0%%": str(_sperm[0]), "%%S1%%": str(_sperm[1]), "%%S2%%": str(_sperm[2]),
+         "%%W%%": _n(roles["W"]), "%%X%%": _n(roles["x"]), "%%NW%%": _n(roles["nw"]),
+         "%%GRID%%": _n(roles["grid"]), "%%RMS%%": _n(roles["rms"]),
+         "%%VEC%%": _n(roles["vec"]), "%%S48%%": _n(roles["s48"]), "%%NWO%%": _n(roles["nwo"]),
+         "%%OUT%%": _n(roles["out"])}
+  src_new = _ATTN_PRELUDE + f'extern "C" __global__ void __launch_bounds__({wpc*32}) {fname}({sig}) {{\n' + _IQ3SW_BODY + "\n}\n"
+  for k, v in sub.items(): src_new = src_new.replace(k, v)
+  # FIX 2026-09-03 (p2_a3e_live_debug.py): the body writes out[warp] for warp < NROWS =
+  # N*batch, so the launch grid MUST scale with batch. The old ceil(N/wpc) grid
+  # under-launched 3x at batch=3 -> out batches 1,2 were NEVER WRITTEN (stale garbage
+  # into GDN block 0 in_proj -> model emitted token 0 forever in production), while
+  # _validate_iq3sw still passed because it compared only the first N outputs (batch 0)
+  # — exactly the one batch the under-launched kernel did write.
+  return src_new, (math.ceil(roles["N"] * roles.get("batch", 1) / wpc), 1, 1), (wpc * 32, 1, 1)
+
+def _validate_iq3sw(renderer, orig_prg, new_prg, roles, sig_args, new_dims):
+  import numpy as np
+  from tinygrad.device import Device, BufferSpec
+  dev = Device[renderer.target.device]
+  rng = np.random.default_rng(2718)
+  N = roles["N"]
+  blocks, _ = _mk_blocks(rng, N * 20)
+  wdata = {}
+  wdata[roles["W"][1]] = blocks.tobytes()
+  _b3 = int(roles.get("batch", 1))
+  wdata[roles["x"][1]] = rng.uniform(-1, 1, 5120*_b3).astype(np.float32).tobytes()
+  wdata[roles["nw"][1]] = rng.uniform(0.5, 1.5, 5120).astype(np.float32).tobytes()
+  wdata[roles["rms"][1]] = np.array([2.3, 0.8, 1.6][:_b3], dtype=np.float32).tobytes()
+  wdata[roles["vec"][1]] = rng.uniform(-1, 1, N*_b3).astype(np.float32).tobytes()
+  wdata[roles["s48"][1]] = rng.uniform(0.5, 2.0, _b3*(N >> 7)).astype(np.float32).tobytes()
+  wdata[roles["nwo"][1]] = rng.uniform(0.5, 1.5, roles["nwo"][2] // 4).astype(np.float32).tobytes()
+  wdata[roles["grid"][1]] = rng.uniform(-1, 1, 1024).astype(np.float32).tobytes()
+  if roles.get("sgns") is not None:
+    # T3 renders carry an EXTERNAL signs table; it must be CONSISTENT with the random
+    # W blocks or orig-vs-new can never match (was: generic random fill -> relerr ~1).
+    wdata[roles["sgns"][1]] = _signs_bytes(blocks, N, 20)
+  bufs, allocs, yidx = [], [], None
+  oname = roles["out"][1]
+  for ctype, name, numel in sig_args:
+    if ctype == "const int": continue
+    nbytes = numel * (2 if ctype == "half*" else 4 if ctype.endswith("*") else 4)
+    b = dev.allocator.alloc(nbytes, BufferSpec())
+    if name == oname: yidx = len(bufs); data = memoryview(bytearray(nbytes)).cast("B")
+    elif name in wdata: data = memoryview(wdata[name]).cast("B")
+    else: data = memoryview(rng.uniform(-1, 1, max(numel, 1)).astype(np.float32).tobytes()).cast("B")
+    dev.allocator._copyin(b, data)
+    bufs.append(b); allocs.append((b, nbytes))
+  rt_orig, rt_new = dev.runtime(orig_prg.to_elf()), dev.runtime(new_prg.to_elf())
+  og, ol = orig_prg.arg.launch_dims({})
+  if ol is None: ol = (1, 1, 1)
+  rt_orig(*bufs, global_size=tuple(og), local_size=tuple(ol), vals=(), wait=True)
+  # FIX 2026-09-03: compare the FULL out (all _b3 batches). The old 2*N compare only
+  # checked batch 0 — the exact blind spot that let an under-launched (wrong-grid)
+  # substitution pass validation bit-exactly while corrupting batches 1,2 in production.
+  _NB = 2 * N * _b3
+  mv = memoryview(bytearray(_NB)); dev.allocator._copyout(mv, bufs[yidx])
+  y_orig = np.frombuffer(mv, dtype=np.float16).astype(np.float32)
+  _fill = bytearray(_NB)
+  _fill[0::4097] = b"\xcd" * len(_fill[0::4097])
+  dev.allocator._copyin(bufs[yidx], memoryview(_fill).cast("B"))
+  rt_new(*bufs, global_size=new_dims[0], local_size=new_dims[1], vals=(), wait=True)
+  mv2 = memoryview(bytearray(_NB)); dev.allocator._copyout(mv2, bufs[yidx])
+  y_new = np.frombuffer(mv2, dtype=np.float16).astype(np.float32)
+  for b_, nb in allocs:
+    try: dev.allocator.free(b_, nb, BufferSpec())
+    except Exception: pass
+  if not (np.isfinite(y_orig).all() and np.isfinite(y_new).all()):
+    print(f"[a3e] nan/inf o={np.isfinite(y_orig).all()} n={np.isfinite(y_new).all()}", flush=True)
+    return False, float("nan")
+  denom = max(float(np.abs(y_orig).max()), 1e-9)
+  rel = float(np.abs(y_orig - y_new).max()) / denom
+  return (rel < 1e-2 and bool(np.allclose(y_orig, y_new, rtol=1e-2, atol=1e-2 * denom))), rel
+
+
+# ---- A3f: T=3 GDN qkv (dot-only, per-batch scales) ----
+_Q5T3_BODY = """  const int warp = (blockIdx.x * %%WPC%%) + (threadIdx.x >> 5);
+  const int lane = threadIdx.x & 31;
+  if (warp < %%NROWS%% * 3) {
+    const int row = warp % %%NROWS%%;
+    const int xrow = (warp / %%NROWS%%) * %%K%%;
+    const float inv_s = 1.0f / %%S%%[warp / %%NROWS%%];
+    const int bg = lane >> 3;
+    const int bbase = ((lane & 7) << 2) + (bg << 5);
+    const int ebase = (bg << 6) + ((lane & 7) << 2);
+    const int hb = bg << 1;
+    float acc = 0.0f;
+    #pragma unroll 2
+    for (int sb = 0; sb < %%NSB%%; ++sb) {
+      const unsigned char* blk = %%W%% + (size_t)row * (size_t)(%%NSB%% * 176) + (size_t)sb * 176;
+      const float d = __half2float(*((const __half*)blk));
+      const float dmin = __half2float(*((const __half*)(blk + 2)));
+      const unsigned char* s = blk + 4;
+      const unsigned char* qh = blk + 16;
+      const unsigned char* qs = blk + 48;
+      float dsA, dmA, dsB, dmB;
+      switch (bg) {
+        case 0: dsA=d*(float)(s[0]&63); dmA=dmin*(float)(s[4]&63); dsB=d*(float)(s[1]&63); dmB=dmin*(float)(s[5]&63); break;
+        case 1: dsA=d*(float)(s[2]&63); dmA=dmin*(float)(s[6]&63); dsB=d*(float)(s[3]&63); dmB=dmin*(float)(s[7]&63); break;
+        case 2: dsA=d*(float)((s[8]&0xF)|((s[0]>>6)<<4)); dmA=dmin*(float)((s[8]>>4)|((s[4]>>6)<<4));
+                dsB=d*(float)((s[9]&0xF)|((s[1]>>6)<<4)); dmB=dmin*(float)((s[9]>>4)|((s[5]>>6)<<4)); break;
+        default: dsA=d*(float)((s[10]&0xF)|((s[2]>>6)<<4)); dmA=dmin*(float)((s[10]>>4)|((s[6]>>6)<<4));
+                 dsB=d*(float)((s[11]&0xF)|((s[3]>>6)<<4)); dmB=dmin*(float)((s[11]>>4)|((s[7]>>6)<<4)); break;
+      }
+      const int xbase = (sb << 8) + xrow + ebase;
+      #pragma unroll
+      for (int k = 0; k < 4; ++k) {
+        const unsigned char qsb = qs[bbase + k];
+        const unsigned char qhb = qh[(bbase + k) & 31];
+        const float w0 = (dsA * (float)(((qsb & 0xF) + (((qhb >> hb) & 1) << 4)))) - dmA;
+        const float w1 = (dsB * (float)(((qsb >> 4) + (((qhb >> (hb + 1)) & 1) << 4)))) - dmB;
+        const int xoff0 = xbase + k;
+        const int xoff1 = xoff0 + 32;
+        const float xw0 = (%%X%%[xoff0] * inv_s * (float)(*((const float*)((%%NW%%) + (xoff0 - xrow) * 4))));
+        const float xw1 = (%%X%%[xoff1] * inv_s * (float)(*((const float*)((%%NW%%) + (xoff1 - xrow) * 4))));
+        acc += __half2float(__hmul(__float2half(xw0), __float2half(w0)))
+             + __half2float(__hmul(__float2half(xw1), __float2half(w1)));
+      }
+    }
+    #pragma unroll
+    for (int o = 16; o > 0; o >>= 1) acc += __shfl_down_sync(0xffffffffu, acc, o);
+    if (lane == 0) { %%OUT%%[%%OFF%% + warp] = %%CAST%%acc; }
+  }"""
+
+def _match_q5t3(args, src):
+  if len(args) != 5: return None
+  fl = [a for a in args if a[0] == "float*"]
+  uc = [a for a in args if a[0] == "unsigned char*"]
+  out = args[0]
+  if out[0] == "float*" and out not in fl: fl = fl + [out]
+  if len(uc) != 2 or len(fl) != (3 if out[0] == "float*" else 2): return None
+  W = max(uc, key=lambda a: a[2]); nw = min(uc, key=lambda a: a[2])
+  if W[2] % 3520 or nw[2] != 20480: return None
+  R = W[2] // 3520
+  if R < 1024: return None
+  if out[0] == "float*":
+    if out[2] != 6 * R: return None
+    off = 3 * R   # GDN qkv T3: [passthrough 3N || 3xN dot]
+  elif out[0] == "half*" and out[2] == 3 * R:
+    off = 0       # lm_head T3: out[b*R + n]
+  else: return None
+  rest = sorted([a for a in fl if a is not out], key=lambda a: a[2])
+  s, x = rest[0], rest[1]
+  if s[2] != 3 or x[2] != 3 * 5120: return None
+  if "half" not in src: return None
+  return dict(kind="q5t3", out=out, x=x, s=s, nw=nw, W=W, N=R, K=5120, NSB=20, off=off)
+
+def _build_q5t3(roles, rule, fname, sig):
+  wpc = int(rule.get("wpc", 4))
+  def _n(a): return f"{a[1]}_{a[2]}"
+  sub = {"%%WPC%%": str(wpc), "%%NROWS%%": str(roles["N"]), "%%K%%": str(roles["K"]),
+         "%%NSB%%": str(roles["NSB"]), "%%W%%": _n(roles["W"]), "%%X%%": _n(roles["x"]),
+         "%%S%%": _n(roles["s"]), "%%NW%%": _n(roles["nw"]), "%%OUT%%": _n(roles["out"]),
+         "%%OFF%%": str(roles.get("off", 3 * roles["N"])),
+         "%%CAST%%": "(__half)" if roles["out"][0] == "half*" else ""}
+  src_new = _ATTN_PRELUDE + f'extern "C" __global__ void __launch_bounds__({wpc*32}) {fname}({sig}) {{\n' + _Q5T3_BODY + "\n}\n"
+  for k, v in sub.items(): src_new = src_new.replace(k, v)
+  return src_new, (math.ceil(roles["N"] * 3 / wpc), 1, 1), (wpc * 32, 1, 1)
+
+
+# ---- A5: generic source transforms (serial-reduce tree + pure-copy vectorize) ----
+# T3/probe context (MTP_T3_LAZY=1) renders DIFFERENT kernel sources at T>1 that the A5
+# unit tests never covered; A5 there produced wrong logits (GREEDY 2/20, 2026-08-29).
+# A5 is perf-neutral at T=1 anyway — disable in T3 runs entirely.
+_A5 = os.getenv("MTP_A5", "1") != "0" and not os.getenv("MTP_T3_LAZY")
+_A5_SKIP = re.compile(os.getenv("MTP_A5_SKIP", "") or "(?x)^$")
+_A5_DUMP = os.getenv("MTP_A5_DUMP", "")
+# NEVER standalone-validate from here: a3b_substitute also runs inside the COMPILE WORKER
+# (codegen/__init__.py hook) where eager device launches are forbidden -> channel wedge ->
+# watchdog reboot (observed 2x 2026-08-29). Parent-side pool kernels are the only safe site;
+# A5 correctness is arbitrated by the in-model greedy gates instead.
+_A5_VAL = os.getenv("MTP_A5_VAL", "0") == "1" and _ADU.value == 1
+
+_A5_LOOP_RE = re.compile(r"for \(int (Ridx\d+) = 0; \1 < (\d+); \1\+\+\) \{\n((?:    [^\n]+\n)+)  \}")
+
+def _a5_one_loop(src, m):
+  rid, K, body = m.group(1), int(m.group(2)), m.group(3)
+  if K < 8 or (K & (K - 1)) != 0: return None
+  if "data" in body: return None
+  shm = re.findall(r"buf\d+", body)
+  if not shm: return None
+  buf = sorted(set(shm), key=shm.index)[0]
+  decl = re.search(r"__shared__[^;]*\b" + buf + r"\[", src)
+  if not decl or not decl.group(0).startswith("__shared__"): return None
+  if buf in src[m.end():]: return None          # tree destroys the shared buffer
+
+  base = None; V = 1
+  if re.search(r"float \w+ = \(\*\(" + buf + r"\+" + rid + r"\)\);", body): V, base = 1, None
+  elif (bm := re.search(r"float \w+ = \(\*\(" + buf + r"\+\((\w+)\+" + rid + r"\)\)\);", body)): V, base = 1, bm.group(1)
+  elif re.search(r"float2 \w+ = \(\*\(\(float2\*\)\(\(" + buf + r"\+\(" + rid + r"<<1\)\)\)\)\);", body): V, base = 2, None
+  elif (bm := re.search(r"float4 \w+ = \(\*\(\(float4\*\)\(\(" + buf + r"\+\((\w+)\+\(" + rid + r"<<2\)\)\)\)\)\);", body)): V, base = 4, bm.group(1)
+  else: return None
+
+  accs = sorted(set(re.findall(r"\*\((buf\d+)\+(\d)\) = \(\(\*\(\1\+\2\)\)\+", body)))
+  if not accs: return None
+  accum = accs[0][0]
+  if sorted({int(a[1]) for a in accs}) != list(range(V)): return None
+
+  pre = src[:m.start()]
+  dim = None; wbase = None; WV = 1
+  if (wm := re.search(r"\*\(\(float4\*\)\(\(" + buf + r"\+\(\((lidx\d+)<<2\)\+(\w+)\)\)\)\) =", pre)):
+    dim, wbase, WV = wm.group(1), wm.group(2), 4
+  elif (wm := re.search(r"\*\(\(float2\*\)\(\(" + buf + r"\+\((lidx\d+)<<1\)\)\)\) =", pre)):
+    dim, wbase, WV = wm.group(1), None, 2
+  elif (wm := re.search(r"\*\(" + buf + r"\+\((lidx\d+)\+(\w+)\)\) =", pre)):
+    dim, wbase, WV = wm.group(1), wm.group(2), 1
+  elif (wm := re.search(r"\*\(" + buf + r"\+(lidx\d+)\) =", pre)):
+    dim, wbase, WV = wm.group(1), None, 1
+  if dim is None or WV != V or (wbase is None) != (base is None): return None
+  b = base if base is not None else "0"
+
+  L = ["  __syncthreads();", f"  for (int a5s = {K >> 1}; a5s > 0; a5s >>= 1) {{"]
+  if V == 1:
+    L.append(f"    if ({dim} < a5s) {{ *({buf}+({b}+{dim})) = ((*({buf}+({b}+{dim})))+*({buf}+({b}+({dim}+a5s)))); }}")
+  else:
+    vt = "float2" if V == 2 else "float4"
+    sh = V.bit_length() - 1
+    mk = "make_float2(((a5p->x)+(a5q->x)),((a5p->y)+(a5q->y)))" if V == 2 else \
+         "make_float4(((a5p->x)+(a5q->x)),((a5p->y)+(a5q->y)),((a5p->z)+(a5q->z)),((a5p->w)+(a5q->w)))"
+    L.append(f"    if ({dim} < a5s) {{")
+    L.append(f"      {vt}* a5p = (({vt}*)(({buf}+({b}+({dim}<<{sh})))));")
+    L.append(f"      const {vt}* a5q = ((const {vt}*)(({buf}+({b}+(({dim}+a5s)<<{sh})))));")
+    L.append(f"      *a5p = {mk};")
+    L.append("    }")
+  L += ["    __syncthreads();", "  }", f"  if (({dim}==0)) {{"]
+  if V == 1:
+    L.append(f"    *({accum}+0) = (*({buf}+({b}+0)));")
+  else:
+    vt = "float2" if V == 2 else "float4"
+    comps = ["x", "y"] if V == 2 else ["x", "y", "z", "w"]
+    L.append(f"    const {vt}* a5r = ((const {vt}*)(({buf}+({b}+0))));")
+    for i, c in enumerate(comps): L.append(f"    *({accum}+{i}) = a5r->{c};")
+  L.append("  }")
+  return "\n".join(L)
+
+def a5_xform_reduce(src):
+  out, n = src, 0
+  for m in reversed(list(_A5_LOOP_RE.finditer(src))):
+    rep = _a5_one_loop(src, m)
+    if rep is not None:
+      out = out[:m.start()] + rep + out[m.end():]
+      n += 1
+  return out, n
+
+_A5_LOAD_LINE = re.compile(r"float (\w+) = \(\*\((data\d+_\d+)\+(alu\d+)\)\);")
+_A5_STORE_LINE = re.compile(r"\*\((data\d+_\d+)\+(alu\d+)\) = (val\d+);")
+
+def a5_xform_copy(src, fname, args):
+  if len(args) != 2 or args[0][0] != "float*" or args[1][0] != "float*": return None
+  if args[0][2] != args[1][2] or args[0][2] % 4 or args[0][2] < 65536: return None
+  body = src[src.index('extern "C"'):]
+  if "if (" in body or "for (" in body or "buf" in body or "exp" in body \
+     or "make_float" in body or "tg_bitcast" in body or "half" in body:
+    return None
+  N = args[0][2]
+  loads = _A5_LOAD_LINE.findall(body)
+  stores = _A5_STORE_LINE.findall(body)
+  if not loads or len(loads) != len(stores): return None
+  ld_vals = {v for v, _, _ in loads}
+  if ld_vals != {v for _, _, v in stores} or len(ld_vals) != len(loads): return None
+  if len({a for _, a, _ in stores}) != len(stores): return None
+  if any(ld != f"data1_{N}" or sd != f"data0_{N}" or la != sa
+         for (_, ld, la), (sd, sa, _) in zip(loads, stores)): return None
+  if len(loads) % 4: return None
+  # NOTE: NEVER grid-stride loops on the TinyGPU dext — gridDim is not provided
+  # (reads as 0 -> i += 0 -> infinite loop -> channel wedge; isolated 2026-08-29).
+  return ('extern "C" __global__ void __launch_bounds__(256) ' + fname +
+          f"(float* data0_{N}, float* data1_{N}) {{\n"
+          f"  const int i = (blockIdx.x*256)+threadIdx.x;\n"
+          f"  if (i < ({N} >> 2)) {{ ((float4*)data0_{N})[i] = ((const float4*)data1_{N})[i]; }}\n"
+          "}\n")
+
+def _a5_validate(renderer, orig_prg, new_prg, args, new_dims):
+  """Standalone compare on synthetic buffers. uchar buffers get the 1.0f byte pattern so
+  byte-assembled floats are sane. Returns (ok, relerr)."""
+  import numpy as np
+  from tinygrad.device import Device, BufferSpec
+  dev = Device[renderer.target.device]
+  if any(a[0] == "const int" for a in args) or orig_prg.arg.vars: return True, 0.0   # can't feed scalars standalone
+  rng = np.random.default_rng(77)
+  bufs, allocs = [], []
+  for i, (ctype, name, numel) in enumerate(args):
+    if ctype == "unsigned char*": nbytes, data = numel, (b"\x00\x00\x80\x3f" * ((numel // 4) + 1))[:numel]
+    elif ctype == "half*":
+      nbytes = numel * 2
+      data = np.clip(rng.standard_normal(numel), -2, 2).astype(np.float16).tobytes()
+    else:
+      nbytes = numel * 4
+      data = bytes(nbytes) if i == 0 else np.clip(rng.standard_normal(numel), -2, 2).astype(np.float32).tobytes()
+    b_ = dev.allocator.alloc(nbytes, BufferSpec())
+    dev.allocator._copyin(b_, memoryview(data).cast("B"))
+    bufs.append(b_); allocs.append((b_, nbytes))
+  try:
+    og, ol = orig_prg.arg.launch_dims({})
+    if ol is None: return True, 0.0
+    rt_o, rt_n = dev.runtime(orig_prg.to_elf()), dev.runtime(new_prg.to_elf())
+    rt_o(*bufs, global_size=tuple(og), local_size=tuple(ol), vals=(), wait=True)
+    on = 4 * args[0][2]
+    mv = memoryview(bytearray(on)); dev.allocator._copyout(mv, bufs[0]); y_o = np.frombuffer(mv, dtype=np.float32).astype(np.float64)
+    dev.allocator._copyin(bufs[0], memoryview(bytes(on)).cast("B"))
+    rt_n(*bufs, global_size=new_dims[0], local_size=new_dims[1], vals=(), wait=True)
+    mv2 = memoryview(bytearray(on)); dev.allocator._copyout(mv2, bufs[0]); y_n = np.frombuffer(mv2, dtype=np.float32).astype(np.float64)
+    if not (np.isfinite(y_o).all() and np.isfinite(y_n).all()): return False, float("nan")
+    rel = float(np.abs(y_o - y_n).max()) / max(float(np.abs(y_o).max()), 1e-9)
+    return rel < 1e-3, rel
+  finally:
+    for b_, nb in allocs:
+      try: dev.allocator.free(b_, nb, BufferSpec())
+      except Exception: pass
+
+def a3b_substitute(prg: UOp, renderer) -> UOp:
