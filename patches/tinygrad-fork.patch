+    if type(renderer).__name__ != "CUDARenderer": return prg
+    if (ret := _subst_cache.get(prg.key)) is not None: return ret
+    if _DUMP_DIR:   # A3B_LOG: raw names for diagnostics (before parse)
+      srcs0 = [s.arg for s in prg.src if s.op is Ops.SOURCE]
+      if srcs0:
+        m0 = _SIG_RE.search(srcs0[0])
+        with open(os.path.join(_DUMP_DIR, "allsigs2.txt"), "a") as f:
