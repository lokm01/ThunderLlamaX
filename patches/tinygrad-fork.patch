+        with open(os.path.join(_DUMP_DIR, f"src_{name}.dims.txt"), "w") as f:
+          f.write(f"global={prg.arg.global_size} local={prg.arg.local_size} vars={[str(v) for v in prg.arg.vars]}\n")
+    parsed = _parse(prg)
+    if parsed is None:
+      if _DUMP_DIR and _DUMP_MATCH and re.search(_DUMP_MATCH, name) and name not in _dumped:
+        _dumped.add(name)
+        srcs0 = [s.arg for s in prg.src if s.op is Ops.SOURCE]
+        if srcs0:
+          with open(os.path.join(_DUMP_DIR, f"src_{name}.cu"), "w") as f: f.write(srcs0[0])
+          with open(os.path.join(_DUMP_DIR, f"src_{name}.dims.txt"), "w") as f:
