+# ==================== SKV-T1: draft fused-PV split-KV (last-CTA combine) ====================
+_SKV_T1_WS = None   # (buffer, va) — ws + self-resetting atomic counter, allocated once
+
+_SKV_T1_BODY = """  float* __restrict__ ws = (float*)%%VA%%ULL;
+  const int s = blockIdx.x >> 2;
+  const int g = blockIdx.x & 3;
+  const int start = s * %%C%%;
+  const int cend = min(start + %%C%%, %%SP%% + 1);
+  const __half* Vg = %%KV%% + (size_t)g * (%%L%% * 256) + (size_t)%%L%% * 1024;
+  __shared__ __align__(16) __half sV[8][256];
+  const int tid = threadIdx.x, lane = tid & 31;
+  const int spr = tid >> 5, sdc = (tid & 31) << 3;
+  struct __align__(16) u4 { unsigned x, y, z, w; };
+  float acc[6][8];
+  #pragma unroll
+  for (int h6 = 0; h6 < 6; h6++)
+    #pragma unroll
+    for (int j = 0; j < 8; j++) acc[h6][j] = 0.0f;
+  const int end = cend - start;
+  for (int t0 = 0; t0 < end; t0 += 8) {
+    if (t0 + spr < end) *(u4*)&sV[spr][sdc] = *(const u4*)(Vg + (size_t)(start + t0 + spr) * 256 + sdc);
+    __syncthreads();
+    const int npos = min(8, end - t0);
+    const int pi = tid >> 5;
+    if (pi < npos) {
+      const int p = start + t0 + pi;
+      #pragma unroll
+      for (int h6 = 0; h6 < 6; h6++) {
+        const float pv = %%P%%[(size_t)(g * 6 + h6) * %%PS%% + p];
+        #pragma unroll
+        for (int j = 0; j < 8; j++)
+          acc[h6][j] += pv * __half2float(sV[pi][(lane << 3) + j]);
+      }
+    }
+    __syncthreads();
+  }
+  #pragma unroll
+  for (int h6 = 0; h6 < 6; h6++) {
+    float* w = ws + ((((size_t)(s * 4 + g) * 6) + h6) * 8 + (tid >> 5)) * 256;
+    #pragma unroll
+    for (int j = 0; j < 8; j++) w[(lane << 3) + j] = acc[h6][j];
+  }
+  float* counter = ws + (size_t)%%S%% * 4 * 6 * 8 * 256;
+  __threadfence();
+  __shared__ unsigned is_last;
+  if (tid == 0) is_last = (atomicAdd(counter, 1u) == (unsigned)(%%S%% * 4 - 1)) ? 1u : 0u;
+  __syncthreads();
+  if (!is_last) return;
+  if (tid == 0) *counter = 0u;
+  for (int h = 0; h < 24; h++) {
+    const int g2 = h / 6, h6 = h % 6;
+    float a = 0.0f;
+    for (int s2 = 0; s2 < %%S%%; s2++)
+      #pragma unroll 8
+      for (int wv = 0; wv < 8; wv++)
+        a += ws[(((size_t)(s2 * 4 + g2) * 6) + h6) * 8 * 256 + (size_t)wv * 256 + tid];
+    const float gt = %%GATE%%[tid + (size_t)h * 512 + 256];
+    %%OUT%%[tid + (size_t)h * 256] = a * (1.0f / (1.0f + exp2f(-gt * 1.4426950216293335f)));
+  }
+"""
+
+def _match_skv_t1(args, src):
+  # stock fused-PV: (out_6144, P_2408376, half KV_205520896, gate_12288, const int sp)
+  if len(args) != 5: return None
+  sc = [a for a in args if a[0] == "const int"]
+  hs = [a for a in args if a[0] == "half*"]
+  fl = [a for a in args if a[0] == "float*"]
+  if len(sc) != 1 or len(hs) != 1 or len(fl) != 3: return None
+  out, P, gate = fl[0], fl[1], fl[2]
+  if P[2] != 2408376: P, gate = gate, P
+  if out[2] != 6144 or P[2] != 2408376 or gate[2] != 12288 or hs[0][2] != 205520896: return None
+  if "exp2" not in src or "+1" not in src: return None   # loop bound sp+1 marker
+  return dict(kind="skv_t1", out=out, P=P, KV=hs[0], gate=gate, SP=sc[0])
+
+def _skv_t1_ws(renderer):
+  global _SKV_T1_WS
+  if _SKV_T1_WS is None:
+    from tinygrad.device import Device, BufferSpec
+    import numpy as _np
+    dev = Device[renderer.target.device]
+    nbytes = (_SKV_S * 4 * 6 * 8 * 256 + 1) * 4
+    b = dev.allocator.alloc(nbytes, BufferSpec())
+    dev.allocator._copyin(b, memoryview(_np.zeros(_SKV_S*4*6*8*256 + 1, _np.float32).tobytes()).cast("B"))
+    _SKV_T1_WS = (b, int(b.va_addr))
+  return _SKV_T1_WS
+
+# ---- A3d: Q5_K warp-per-row GEMVs (lm_head fp32 path + GDN qkv half path) ----
+_Q5_BODY = """  const int warp = (blockIdx.x * %%WPC%%) + (threadIdx.x >> 5);
+  const int lane = threadIdx.x & 31;
+  if (warp < %%NROWS%%) {
+    float acc = 0.0f;
+    const int bg = lane >> 3;                                // byte group 0..3 (32 qs bytes each)
+    const int bbase = ((lane & 7) << 2) + (bg << 5);         // this lane's 4 consecutive qs bytes
+    const int ebase = (bg << 6) + ((lane & 7) << 2);         // low-nibble element base (probed mapping)
+    const int hb = bg << 1;                                  // qh bit for low elements; +1 for high
+    #pragma unroll 2
+    for (int sb = 0; sb < %%NSB%%; ++sb) {
+      const unsigned char* blk = %%W%% + (size_t)warp * (size_t)(%%NSB%% * 176) + (size_t)sb * 176;
+      const float d = __half2float(*((const __half*)blk));
+      const float dmin = __half2float(*((const __half*)(blk + 2)));
+      const unsigned char* s = blk + 4;
+      const unsigned char* qh = blk + 16;
+      const unsigned char* qs = blk + 48;
+      const float sca=(float)(s[0]&63), scb=(float)(s[1]&63), scc=(float)(s[2]&63), scd=(float)(s[3]&63);
+      const float sce=(float)((s[8]&0xF)|((s[0]>>6)<<4)), scf=(float)((s[9]&0xF)|((s[1]>>6)<<4));
+      const float scg=(float)((s[10]&0xF)|((s[2]>>6)<<4)), sch=(float)((s[11]&0xF)|((s[3]>>6)<<4));
+      const float mna=(float)(s[4]&63), mnb=(float)(s[5]&63), mnc=(float)(s[6]&63), mnd=(float)(s[7]&63);
+      const float mne=(float)((s[8]>>4)|((s[4]>>6)<<4)), mnf=(float)((s[9]>>4)|((s[5]>>6)<<4));
+      const float mng=(float)((s[10]>>4)|((s[6]>>6)<<4)), mnh=(float)((s[11]>>4)|((s[7]>>6)<<4));
+      float dsA, dmA, dsB, dmB;                              // sub 2*bg and 2*bg+1 scale products
+      switch (bg) {
+        case 0: dsA=d*sca; dmA=dmin*mna; dsB=d*scb; dmB=dmin*mnb; break;
+        case 1: dsA=d*scc; dmA=dmin*mnc; dsB=d*scd; dmB=dmin*mnd; break;
+        case 2: dsA=d*sce; dmA=dmin*mne; dsB=d*scf; dmB=dmin*mnf; break;
+        default: dsA=d*scg; dmA=dmin*mng; dsB=d*sch; dmB=dmin*mnh; break;
+      }
+      const int xbase = (sb << 8) + ebase;
+      #pragma unroll
+      for (int k = 0; k < 4; ++k) {
+        const unsigned char qsb = qs[bbase + k];
+        const unsigned char qhb = qh[(bbase + k) & 31];
+        const float w0 = (dsA * (float)(((qsb & 0xF) + (((qhb >> hb) & 1) << 4)))) - dmA;
+        const float w1 = (dsB * (float)(((qsb >> 4) + (((qhb >> (hb + 1)) & 1) << 4)))) - dmB;
+        const int xoff0 = xbase + k;
+        const int xoff1 = xoff0 + 32;
+        const float xw0 = %%XW0%%;
+        const float xw1 = %%XW1%%;
+        %%ACC%%;
+      }
+    }
+    #pragma unroll
+    for (int o = 16; o > 0; o >>= 1) acc += __shfl_down_sync(0xffffffffu, acc, o);
+    if (lane == 0) { %%EPILOGUE%% }
+    %%PASSTHROUGH%%
+  }"""
+
+def _match_q5head(args, src):
+  if len(args) != 7: return None
+  fl = [a for a in args if a[0] == "float*"]
+  uc = [a for a in args if a[0] == "unsigned char*"]
+  if len(uc) != 2 or len(fl) != 5: return None
+  out = args[0]
+  if out[0] != "float*": return None
+  W = max(uc, key=lambda a: a[2]); nw = min(uc, key=lambda a: a[2])
+  if W[2] % 3520 or nw[2] != 20480: return None
+  R = W[2] // 3520
+  if R < 1024 or out[2] != R: return None
+  rest = sorted([a for a in fl if a is not out], key=lambda a: a[2])
+  aux, x, s1, s2 = rest[3], rest[2], rest[0], rest[1]
+  if aux[2] != R or x[2] != 5120 or s1[2] != 1 or s2[2] != 1: return None
+  if "log2" not in src: return None
+  return dict(kind="q5head", out=out, x=x, s1=s1, s2=s2, nw=nw, W=W, aux=aux, N=R, K=5120, NSB=20)
+
+def _match_q5conv(args, src):
+  if len(args) != 7: return None
+  sc = [a for a in args if a[0] == "const int"]
+  fl = [a for a in args if a[0] == "float*"]
+  uc = [a for a in args if a[0] == "unsigned char*"]
+  if len(sc) != 1 or len(uc) != 2 or len(fl) != 4: return None
+  out = args[0]
+  if out[0] != "float*": return None
+  W = max(uc, key=lambda a: a[2]); nw = min(uc, key=lambda a: a[2])
+  if W[2] % 3520 or nw[2] != 20480: return None
+  R = W[2] // 3520
+  if R < 1024 or out[2] != 4 * R: return None
+  rest = sorted([a for a in fl if a is not out], key=lambda a: a[2])
+  s, x, inn = rest[0], rest[1], rest[2]
+  if s[2] != 1 or x[2] != 5120 or inn[2] != 3 * R: return None
+  if "half" not in src: return None
+  return dict(kind="q5conv", out=out, inn=inn, x=x, s=s, nw=nw, W=W, sp=sc[0], N=R, K=5120, NSB=20)
+
+def _n_(a): return f"{a[1]}_{a[2]}"
+
+def _build_q5(roles, rule, fname, sig):
+  kind = roles["kind"]
+  wpc = int(rule.get("wpc", 4))
+  sub = {"%%WPC%%": str(wpc), "%%NROWS%%": str(roles["N"]), "%%NSB%%": str(roles["NSB"]),
+         "%%W%%": _n_(roles["W"])}
+  if kind == "q5head":
+    _xw = lambda o: f"({_n_(roles['x'])}[({o})] * (float)(*((const float*)(({_n_(roles['nw'])}) + ({o}) * 4))))"
+    sub["%%XW0%%"] = _xw("xoff0")
+    sub["%%XW1%%"] = _xw("xoff1")
+    sub["%%ACC%%"] = "acc += xw0 * w0 + xw1 * w1"
+    sub["%%EPILOGUE%%"] = (
+      f"const float _s1 = {_n_(roles['s1'])}[0]; "
+      f"const float _s2 = {_n_(roles['s2'])}[0]; "
+      f"const float _a = {_n_(roles['aux'])}[warp]; "
+      f"const float _acl = (_a < 9.999999960041972e-13f) ? 9.999999960041972e-13f : _a; "
+      f"const float _s2c = (_s2 < 9.999999960041972e-13f) ? 9.999999960041972e-13f : _s2; "
+      f"{_n_(roles['out'])}[warp] = (acc * (1.0f / (_s1 * _s2c))) + "
+      f"(log2f((log2f(_acl) * -0.6931471824645996f)) * -0.6931471824645996f);")
+    sub["%%PASSTHROUGH%%"] = ""
+    grid, local = (math.ceil(roles["N"] / wpc), 1, 1), (wpc * 32, 1, 1)
+  else:
+    _xw = lambda o: (f"({_n_(roles['x'])}[({o})] * (1.0f / {_n_(roles['s'])}[0]) * "
+                     f"(float)(*((const float*)(({_n_(roles['nw'])}) + ({o}) * 4))))")
+    sub["%%XW0%%"] = _xw("xoff0")
+    sub["%%XW1%%"] = _xw("xoff1")
+    sub["%%ACC%%"] = ("acc += __half2float(__hmul(__float2half(xw0), __float2half(w0))) "
+                      "+ __half2float(__hmul(__float2half(xw1), __float2half(w1)))")
+    sub["%%EPILOGUE%%"] = f"{_n_(roles['out'])}[(%%NP%%) + warp] = acc;"
+    sub["%%EPILOGUE%%"] = sub["%%EPILOGUE%%"].replace("%%NP%%", str(3 * roles["N"]))
+    sub["%%PASSTHROUGH%%"] = (
+      f"    if (lane < 3) {{ const int _off = warp + lane * {roles['N']}; "
+      f"{_n_(roles['out'])}[_off] = ({roles['sp'][1]}_ != 0) ? {_n_(roles['inn'])}[_off] : 0.0f; }}")
+    grid, local = (math.ceil(roles["N"] / wpc), 1, 1), (wpc * 32, 1, 1)
+  src_new = _ATTN_PRELUDE + f'extern "C" __global__ void __launch_bounds__({local[0]}) {fname}({sig}) {{\n' + _Q5_BODY + "\n}\n"
+  for k, v in sub.items(): src_new = src_new.replace(k, v)
+  return src_new, grid, local
+
+def _validate_q5(renderer, orig_prg, new_prg, roles, sig_args, new_dims):
+  import numpy as np
+  from tinygrad.device import Device, BufferSpec
+  dev = Device[renderer.target.device]
+  rng = np.random.default_rng(31337)
+  N = roles["N"]
+  # valid random Q5_K rows: small d/dmin, arbitrary scale/quant bytes
+  Wb = np.zeros((N, 3520), dtype=np.uint8)
+  if os.getenv("A3D_DBG_Q5") == "1":
+    # deterministic: every row d=1.0 dmin=0 sc[0]=8, all qs/qh/scales else 0 -> only j=0 has q=1
+    Wb[:, 0:2] = np.array([0x00, 0x3C], dtype=np.uint8)
