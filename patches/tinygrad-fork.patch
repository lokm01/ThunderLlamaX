+    __syncthreads();
+    const int tn = t0 + 32;
+    kvalid = tn + spr < cend;
+    if (kvalid) {
+      const skv_u4* ksrc = (const skv_u4*)(Kg + (size_t)(tn + spr) * 256 + sdc);
+      const skv_u4* vsrc = (const skv_u4*)(Vg + (size_t)(tn + spr) * 256 + sdc);
+      #pragma unroll
+      for (int e = 0; e < 4; e++) { kp[e] = ksrc[e]; vp[e] = vsrc[e]; }
+    }
