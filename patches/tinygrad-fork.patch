+        _combos = [((2, 0, 1), (0, 1, 2))] + [(rp, sp) for rp in _P6 for sp in _P6 if (rp, sp) != ((2, 0, 1), (0, 1, 2))]
+      for _rperm, _sperm in _combos:
+        iroles["rperm"] = _rperm; iroles["sperm"] = _sperm
+        new_src, grid, local = _build_iq3sw(iroles, irule, to_function_name(new_name), sig)
+        lib = renderer.compiler.compile_cached(new_src)
+        new_arg = dc_replace(prg.arg, name=new_name, global_size=grid, local_size=local)
+        new_prg = prg.replace(src=(prg.src[0], prg.src[1], UOp(Ops.SOURCE, arg=new_src), UOp(Ops.BINARY, arg=lib)), arg=new_arg)
+        if not _val_ok():
+          _subst_cache[prg.key] = new_prg
