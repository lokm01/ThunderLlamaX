+        except Exception as _ve:
+          print(f"[a3e] {name} perm{_perm} validation could not run: {type(_ve).__name__} -> STOCK", flush=True)
+          _subst_cache[prg.key] = prg
+          return prg
+        print(f"[a3e] {name} rms={_rperm} s48={_sperm} relerr={rel:.2e} {'OK' if ok else 'FAIL'}", flush=True)
+        if ok:
+          print(f"[a3e] {name} -> {new_name} N={iroles['N']} grid={grid} local={local} rms={_rperm} s48={_sperm}", flush=True)
+          _subst_cache[prg.key] = new_prg
+          return new_prg
+      print(f"[a3e] {name}: no permutation validated -> STOCK", flush=True)
+      _subst_cache[prg.key] = prg
+      return prg
+    # ---- A3d Q5_K GEMV path (lm_head fp32 + GDN qkv half) ----
+    qroles = None
+    for mf in (_match_q5head, _match_q5conv):
