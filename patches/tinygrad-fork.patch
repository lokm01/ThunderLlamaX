+_SKV_PRELUDE = """#include <cuda_fp16.h>
+#define NEG_INF (__int_as_float(0xff800000))
+struct __align__(16) skv_u4 { unsigned x, y, z, w; };
+"""
+
+def _build_skv(fname, sig, body, roles, va):
+  src = _SKV_PRELUDE + f'extern "C" __global__ void __launch_bounds__(256) {fname}({sig}) {{\n' + body + "\n}\n"
+  L = roles["L"]
+  C = (L + _SKV_S - 1) // _SKV_S
+  nm = lambda a: a[1] + "_" if a[0] == "const int" else a[1] + "_" + str(a[2])   # sig names carry _numel suffix
+  sub = {"%%L%%": str(L), "%%C%%": str(C), "%%S%%": str(_SKV_S), "%%VA%%": hex(va), "%%P%%": nm(roles["P"])}
+  if roles["kind"] == "skv_qk":
+    sub["%%Q%%"] = nm(roles["Q"]); sub["%%KV%%"] = nm(roles["KV"]); sub["%%SP%%"] = nm(roles["SP"])
+  else:
+    sub["%%OUT%%"] = nm(roles["out"]); sub["%%GATE%%"] = nm(roles["gate"])
+  for k, v in sub.items(): src = src.replace(k, v)
+  return src
+
+def _validate_skv(renderer, orig_qk, orig_pv, new_k1, new_k2, roles):
+  import numpy as np
+  from tinygrad.device import Device, BufferSpec
+  dev = Device[renderer.target.device]
+  rng = np.random.default_rng(4242)
+  L = roles["L"]
+  sp = L - 2000
+  def ab(nb): return dev.allocator.alloc(nb, BufferSpec())
+  def up(arr):
+    b = ab(len(arr) * 4); dev.allocator._copyin(b, memoryview(arr.astype(np.float32).tobytes()).cast("B")); return b
+  Qb = up((rng.standard_normal(18432) * 0.5).astype(np.float32))
+  KVh = (rng.standard_normal(L * 2048) * 0.3).astype(np.float16)
+  KVb = ab(L * 2048 * 2); dev.allocator._copyin(KVb, memoryview(KVh.tobytes()).cast("B"))
+  Gb = up((rng.standard_normal(36864) * 0.5).astype(np.float32))
+  Pb = ab(72 * L * 4)
+  o1, o2 = ab(18432 * 4), ab(18432 * 4)
+  allocs = [(Qb, 18432*4), (KVb, L*2048*2), (Gb, 36864*4), (Pb, 72*L*4), (o1, 18432*4), (o2, 18432*4)]
+  try:
+    rt_oq = dev.runtime(orig_qk.to_elf())
+    og, ol = orig_qk.arg.launch_dims({})
+    if ol is None: ol = (1, 1, 1)
+    rt_oq(Pb, Qb, KVb, global_size=tuple(og), local_size=tuple(ol), vals=(sp,), wait=True)
+    mv = memoryview(bytearray(72 * L * 4)); dev.allocator._copyout(mv, Pb)
+    Pn = np.frombuffer(mv, np.float32).reshape(72, L)
+    mx = Pn.max(axis=1).astype(np.float32)
+    sm = np.exp2((Pn - mx[:, None]) * np.float32(1.4426950216293335)).sum(axis=1).astype(np.float32)
+    mxb, smb = up(mx), up(sm); allocs += [(mxb, 288), (smb, 288)]
+    rt_op = dev.runtime(orig_pv.to_elf())
+    pg, pl = orig_pv.arg.launch_dims({})
+    if pl is None: pl = (1, 1, 1)
+    rt_op(o1, Pb, mxb, smb, KVb, Gb, global_size=tuple(pg), local_size=tuple(pl), vals=(0,), wait=True)
+    rt_k1 = dev.runtime(new_k1.to_elf())
+    rt_k1(Pb, Qb, KVb, global_size=(_SKV_S * 12, 1, 1), local_size=(256, 1, 1), vals=(sp,), wait=True)
+    rt_k2 = dev.runtime(new_k2.to_elf())
+    rt_k2(o2, Pb, mxb, smb, KVb, Gb, global_size=(72, 1, 1), local_size=(256, 1, 1), vals=(0,), wait=True)
+    m1 = memoryview(bytearray(18432 * 4)); dev.allocator._copyout(m1, o1)
+    m2 = memoryview(bytearray(18432 * 4)); dev.allocator._copyout(m2, o2)
+    y1 = np.frombuffer(m1, np.float32).copy(); y2 = np.frombuffer(m2, np.float32).copy()
+    if not (np.isfinite(y1).all() and np.isfinite(y2).all()):
+      return False, float("nan")
+    rel = float(np.abs(y1 - y2).max()) / max(float(np.abs(y1).max()), 1e-9)
+    return (rel < 1e-4), rel
+  finally:
+    for b, nb in allocs:
+      try: dev.allocator.free(b, nb, BufferSpec())
+      except Exception: pass
+
